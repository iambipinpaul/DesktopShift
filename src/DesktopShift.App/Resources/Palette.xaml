<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <Color x:Key="DesktopShift.WindowBackgroundColor">#CC0C1517</Color>
            <Color x:Key="DesktopShift.PaneBackgroundColor">#E6122022</Color>
            <Color x:Key="DesktopShift.SurfaceColor">#E619292C</Color>
            <Color x:Key="DesktopShift.SurfaceSecondaryColor">#CC213437</Color>
            <Color x:Key="DesktopShift.BorderColor">#4D789093</Color>
            <Color x:Key="DesktopShift.TextPrimaryColor">#FFF2F7F6</Color>
            <Color x:Key="DesktopShift.TextSecondaryColor">#FFA9BCB9</Color>
            <Color x:Key="DesktopShift.AccentColor">#FF43D6C4</Color>
            <Color x:Key="DesktopShift.AccentStrongColor">#FF74E6D8</Color>
            <Color x:Key="DesktopShift.AccentSoftColor">#293FD1BE</Color>
            <Color x:Key="DesktopShift.SuccessColor">#FF73D7A1</Color>
            <Color x:Key="DesktopShift.WarningColor">#FFF0C674</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="DesktopShift.WindowBackgroundColor">#DCF3F8F7</Color>
            <Color x:Key="DesktopShift.PaneBackgroundColor">#F2F8FBFA</Color>
            <Color x:Key="DesktopShift.SurfaceColor">#F7FFFFFF</Color>
            <Color x:Key="DesktopShift.SurfaceSecondaryColor">#FFE7F1EF</Color>
            <Color x:Key="DesktopShift.BorderColor">#40607A77</Color>
            <Color x:Key="DesktopShift.TextPrimaryColor">#FF142220</Color>
            <Color x:Key="DesktopShift.TextSecondaryColor">#FF536966</Color>
            <Color x:Key="DesktopShift.AccentColor">#FF087F75</Color>
            <Color x:Key="DesktopShift.AccentStrongColor">#FF056A62</Color>
            <Color x:Key="DesktopShift.AccentSoftColor">#1F087F75</Color>
            <Color x:Key="DesktopShift.SuccessColor">#FF16764A</Color>
            <Color x:Key="DesktopShift.WarningColor">#FF855A00</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="DesktopShift.WindowBackgroundColor">#CC0C1517</Color>
            <Color x:Key="DesktopShift.PaneBackgroundColor">#E6122022</Color>
            <Color x:Key="DesktopShift.SurfaceColor">#E619292C</Color>
            <Color x:Key="DesktopShift.SurfaceSecondaryColor">#CC213437</Color>
            <Color x:Key="DesktopShift.BorderColor">#4D789093</Color>
            <Color x:Key="DesktopShift.TextPrimaryColor">#FFF2F7F6</Color>
            <Color x:Key="DesktopShift.TextSecondaryColor">#FFA9BCB9</Color>
            <Color x:Key="DesktopShift.AccentColor">#FF43D6C4</Color>
            <Color x:Key="DesktopShift.AccentStrongColor">#FF74E6D8</Color>
            <Color x:Key="DesktopShift.AccentSoftColor">#293FD1BE</Color>
            <Color x:Key="DesktopShift.SuccessColor">#FF73D7A1</Color>
            <Color x:Key="DesktopShift.WarningColor">#FFF0C674</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <SolidColorBrush x:Key="DesktopShift.WindowBackgroundBrush" Color="{ThemeResource DesktopShift.WindowBackgroundColor}" />
    <SolidColorBrush x:Key="DesktopShift.PaneBackgroundBrush" Color="{ThemeResource DesktopShift.PaneBackgroundColor}" />
    <SolidColorBrush x:Key="DesktopShift.SurfaceBrush" Color="{ThemeResource DesktopShift.SurfaceColor}" />
    <SolidColorBrush x:Key="DesktopShift.SurfaceSecondaryBrush" Color="{ThemeResource DesktopShift.SurfaceSecondaryColor}" />
    <SolidColorBrush x:Key="DesktopShift.BorderBrush" Color="{ThemeResource DesktopShift.BorderColor}" />
    <SolidColorBrush x:Key="DesktopShift.TextPrimaryBrush" Color="{ThemeResource DesktopShift.TextPrimaryColor}" />
    <SolidColorBrush x:Key="DesktopShift.TextSecondaryBrush" Color="{ThemeResource DesktopShift.TextSecondaryColor}" />
    <SolidColorBrush x:Key="DesktopShift.AccentBrush" Color="{ThemeResource DesktopShift.AccentColor}" />
    <SolidColorBrush x:Key="DesktopShift.AccentStrongBrush" Color="{ThemeResource DesktopShift.AccentStrongColor}" />
    <SolidColorBrush x:Key="DesktopShift.AccentSoftBrush" Color="{ThemeResource DesktopShift.AccentSoftColor}" />
    <SolidColorBrush x:Key="DesktopShift.SuccessBrush" Color="{ThemeResource DesktopShift.SuccessColor}" />
    <SolidColorBrush x:Key="DesktopShift.WarningBrush" Color="{ThemeResource DesktopShift.WarningColor}" />
</ResourceDictionary>
