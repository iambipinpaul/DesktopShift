<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The shell geometry and neutral surfaces mirror the Windows 11 settings
         concept in preview.html. Accent and accessibility colors still resolve
         through WinUI; High Contrast uses only system-owned resources. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="DesktopShift.WindowBackgroundBrush" Color="#272727" />
            <SolidColorBrush x:Key="DesktopShift.TitleBarBackgroundBrush" Color="#1B1B1B" />
            <SolidColorBrush x:Key="DesktopShift.PaneBackgroundBrush" Color="#202020" />
            <SolidColorBrush x:Key="DesktopShift.SurfaceBrush" Color="#2D2D2D" />
            <SolidColorBrush x:Key="DesktopShift.SurfaceSecondaryBrush" Color="#292929" />
            <SolidColorBrush x:Key="DesktopShift.BorderBrush" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="DesktopShift.TextPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DesktopShift.TextSecondaryBrush" Color="#D2D2D2" />
            <StaticResource x:Key="DesktopShift.AccentBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="DesktopShift.AccentStrongBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <StaticResource x:Key="DesktopShift.AccentSoftBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="DesktopShift.SuccessBrush" ResourceKey="SystemFillColorSuccessBrush" />
            <StaticResource x:Key="DesktopShift.WarningBrush" ResourceKey="SystemFillColorCautionBrush" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="DesktopShift.WindowBackgroundBrush" Color="#F7F7F7" />
            <SolidColorBrush x:Key="DesktopShift.TitleBarBackgroundBrush" Color="#F6F6F6" />
            <SolidColorBrush x:Key="DesktopShift.PaneBackgroundBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="DesktopShift.SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DesktopShift.SurfaceSecondaryBrush" Color="#F5F5F5" />
            <SolidColorBrush x:Key="DesktopShift.BorderBrush" Color="#13000000" />
            <SolidColorBrush x:Key="DesktopShift.TextPrimaryBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="DesktopShift.TextSecondaryBrush" Color="#4A4A4A" />
            <StaticResource x:Key="DesktopShift.AccentBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="DesktopShift.AccentStrongBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <StaticResource x:Key="DesktopShift.AccentSoftBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="DesktopShift.SuccessBrush" ResourceKey="SystemFillColorSuccessBrush" />
            <StaticResource x:Key="DesktopShift.WarningBrush" ResourceKey="SystemFillColorCautionBrush" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="DesktopShift.WindowBackgroundBrush" Color="#272727" />
            <SolidColorBrush x:Key="DesktopShift.TitleBarBackgroundBrush" Color="#1B1B1B" />
            <SolidColorBrush x:Key="DesktopShift.PaneBackgroundBrush" Color="#202020" />
            <SolidColorBrush x:Key="DesktopShift.SurfaceBrush" Color="#2D2D2D" />
            <SolidColorBrush x:Key="DesktopShift.SurfaceSecondaryBrush" Color="#292929" />
            <SolidColorBrush x:Key="DesktopShift.BorderBrush" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="DesktopShift.TextPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DesktopShift.TextSecondaryBrush" Color="#D2D2D2" />
            <StaticResource x:Key="DesktopShift.AccentBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="DesktopShift.AccentStrongBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <StaticResource x:Key="DesktopShift.AccentSoftBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="DesktopShift.SuccessBrush" ResourceKey="SystemFillColorSuccessBrush" />
            <StaticResource x:Key="DesktopShift.WarningBrush" ResourceKey="SystemFillColorCautionBrush" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="DesktopShift.WindowBackgroundBrush" ResourceKey="ApplicationPageBackgroundThemeBrush" />
            <StaticResource x:Key="DesktopShift.TitleBarBackgroundBrush" ResourceKey="ApplicationPageBackgroundThemeBrush" />
            <StaticResource x:Key="DesktopShift.PaneBackgroundBrush" ResourceKey="LayerOnMicaBaseAltFillColorDefaultBrush" />
            <StaticResource x:Key="DesktopShift.SurfaceBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="DesktopShift.SurfaceSecondaryBrush" ResourceKey="LayerFillColorDefaultBrush" />
            <StaticResource x:Key="DesktopShift.BorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="DesktopShift.TextPrimaryBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="DesktopShift.TextSecondaryBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="DesktopShift.AccentBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="DesktopShift.AccentStrongBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <StaticResource x:Key="DesktopShift.AccentSoftBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="DesktopShift.SuccessBrush" ResourceKey="SystemFillColorSuccessBrush" />
            <StaticResource x:Key="DesktopShift.WarningBrush" ResourceKey="SystemFillColorCautionBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
