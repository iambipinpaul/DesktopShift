<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Every brush is declared once per theme rather than as one brush over a
        per-theme colour. A high-contrast theme has no colours of its own to
        borrow: it has system colours the user chose, and those arrive as
        SystemColor*Color theme resources that only a brush can read. Declaring
        the brushes here is what lets the HighContrast dictionary answer with
        the user's colours instead of DesktopShift's teal.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="DesktopShift.WindowBackgroundBrush" Color="#CC0C1517" />
            <SolidColorBrush x:Key="DesktopShift.PaneBackgroundBrush" Color="#E6122022" />
            <SolidColorBrush x:Key="DesktopShift.SurfaceBrush" Color="#E619292C" />
            <SolidColorBrush x:Key="DesktopShift.SurfaceSecondaryBrush" Color="#CC213437" />
            <SolidColorBrush x:Key="DesktopShift.BorderBrush" Color="#4D789093" />
            <SolidColorBrush x:Key="DesktopShift.TextPrimaryBrush" Color="#FFF2F7F6" />
            <SolidColorBrush x:Key="DesktopShift.TextSecondaryBrush" Color="#FFA9BCB9" />
            <SolidColorBrush x:Key="DesktopShift.AccentBrush" Color="#FF43D6C4" />
            <SolidColorBrush x:Key="DesktopShift.AccentStrongBrush" Color="#FF74E6D8" />
            <SolidColorBrush x:Key="DesktopShift.AccentSoftBrush" Color="#293FD1BE" />
            <SolidColorBrush x:Key="DesktopShift.SuccessBrush" Color="#FF73D7A1" />
            <SolidColorBrush x:Key="DesktopShift.WarningBrush" Color="#FFF0C674" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="DesktopShift.WindowBackgroundBrush" Color="#DCF3F8F7" />
            <SolidColorBrush x:Key="DesktopShift.PaneBackgroundBrush" Color="#F2F8FBFA" />
            <SolidColorBrush x:Key="DesktopShift.SurfaceBrush" Color="#F7FFFFFF" />
            <SolidColorBrush x:Key="DesktopShift.SurfaceSecondaryBrush" Color="#FFE7F1EF" />
            <SolidColorBrush x:Key="DesktopShift.BorderBrush" Color="#40607A77" />
            <SolidColorBrush x:Key="DesktopShift.TextPrimaryBrush" Color="#FF142220" />
            <SolidColorBrush x:Key="DesktopShift.TextSecondaryBrush" Color="#FF536966" />
            <SolidColorBrush x:Key="DesktopShift.AccentBrush" Color="#FF087F75" />
            <SolidColorBrush x:Key="DesktopShift.AccentStrongBrush" Color="#FF056A62" />
            <SolidColorBrush x:Key="DesktopShift.AccentSoftBrush" Color="#1F087F75" />
            <SolidColorBrush x:Key="DesktopShift.SuccessBrush" Color="#FF16764A" />
            <SolidColorBrush x:Key="DesktopShift.WarningBrush" Color="#FF855A00" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="DesktopShift.WindowBackgroundBrush" Color="#CC0C1517" />
            <SolidColorBrush x:Key="DesktopShift.PaneBackgroundBrush" Color="#E6122022" />
            <SolidColorBrush x:Key="DesktopShift.SurfaceBrush" Color="#E619292C" />
            <SolidColorBrush x:Key="DesktopShift.SurfaceSecondaryBrush" Color="#CC213437" />
            <SolidColorBrush x:Key="DesktopShift.BorderBrush" Color="#4D789093" />
            <SolidColorBrush x:Key="DesktopShift.TextPrimaryBrush" Color="#FFF2F7F6" />
            <SolidColorBrush x:Key="DesktopShift.TextSecondaryBrush" Color="#FFA9BCB9" />
            <SolidColorBrush x:Key="DesktopShift.AccentBrush" Color="#FF43D6C4" />
            <SolidColorBrush x:Key="DesktopShift.AccentStrongBrush" Color="#FF74E6D8" />
            <SolidColorBrush x:Key="DesktopShift.AccentSoftBrush" Color="#293FD1BE" />
            <SolidColorBrush x:Key="DesktopShift.SuccessBrush" Color="#FF73D7A1" />
            <SolidColorBrush x:Key="DesktopShift.WarningBrush" Color="#FFF0C674" />
        </ResourceDictionary>

        <!--
            A high-contrast theme is a promise the user made to themselves about
            how their whole desktop will look, so DesktopShift keeps none of its
            own colours here. Surfaces collapse onto the window colour, every
            separator and outline becomes window text so it stays visible, and
            the accent becomes the system hotlight. Secondary text deliberately
            does not use SystemColorGrayTextColor: grey text means disabled in a
            high-contrast theme, and this text is live content.
        -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="DesktopShift.WindowBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DesktopShift.PaneBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DesktopShift.SurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DesktopShift.SurfaceSecondaryBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DesktopShift.BorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DesktopShift.TextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DesktopShift.TextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DesktopShift.AccentBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="DesktopShift.AccentStrongBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="DesktopShift.AccentSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DesktopShift.SuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DesktopShift.WarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
