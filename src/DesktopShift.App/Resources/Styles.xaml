<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Spacing is a four-point rhythm. Every gap a page can choose is named
        here, so a page never invents a number and two pages never disagree
        about what "a bit of room" means.
    -->
    <x:Double x:Key="DesktopShift.PageContentMaxWidth">1000</x:Double>
    <x:Double x:Key="DesktopShift.SectionSpacing">24</x:Double>
    <x:Double x:Key="DesktopShift.CardSpacing">14</x:Double>
    <x:Double x:Key="DesktopShift.GroupSpacing">14</x:Double>
    <x:Double x:Key="DesktopShift.ItemSpacing">8</x:Double>
    <x:Double x:Key="DesktopShift.TightSpacing">4</x:Double>
    <x:Double x:Key="DesktopShift.CardPadding">15</x:Double>

    <!--
        Padding and margin are Thickness, and a Thickness property will not
        accept the plain number a spacing token carries. So an inset gets its
        own token even when it holds the same value as the spacing beside it:
        GroupPadding is the Thickness form of GroupSpacing, and a page that
        needs to pad rather than space reaches for this one.
    -->
    <Thickness x:Key="DesktopShift.PageMargin">30,30,30,64</Thickness>
    <Thickness x:Key="DesktopShift.GroupPadding">12</Thickness>
    <Thickness x:Key="DesktopShift.PillPadding">12,4,12,4</Thickness>
    <Thickness x:Key="DesktopShift.BadgePadding">8,4,8,4</Thickness>

    <CornerRadius x:Key="DesktopShift.CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="DesktopShift.ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="DesktopShift.PillCornerRadius">999</CornerRadius>

    <x:Double x:Key="DesktopShift.IconTileSize">40</x:Double>

    <!--
        Headings are marked as headings so a screen-reader user can jump between
        the sections of a page instead of arrowing through every line of it.
        Only the styles that always label a section carry a level: the section
        title style is also used for values, so those pages set the level on the
        heading itself rather than inheriting one that would be a lie.
    -->
    <Style x:Key="DesktopShift.PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource DesktopShift.TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
    </Style>

    <Style x:Key="DesktopShift.PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="21" />
        <Setter Property="Foreground" Value="{ThemeResource DesktopShift.TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DesktopShift.SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource DesktopShift.TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style
        x:Key="DesktopShift.SectionLabelStyle"
        BasedOn="{StaticResource DesktopShift.SectionTitleStyle}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
    </Style>

    <!-- A section title that really does head a section, and says so. -->
    <Style
        x:Key="DesktopShift.SectionHeadingStyle"
        BasedOn="{StaticResource DesktopShift.SectionTitleStyle}"
        TargetType="TextBlock">
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
    </Style>

    <Style x:Key="DesktopShift.BodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource DesktopShift.TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DesktopShift.CaptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource DesktopShift.TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
        The label above a value in a detail grid. It looks like a caption, but
        the pages point each value at its label with AutomationProperties.LabeledBy
        so a screen reader reads "Target desktop, Focus" rather than announcing a
        bare value and leaving the user to guess what it was.
    -->
    <Style
        x:Key="DesktopShift.FieldLabelStyle"
        BasedOn="{StaticResource DesktopShift.CaptionStyle}"
        TargetType="TextBlock" />

    <!--
        Identifiers are read character by character, so they get a font where a
        zero cannot be an O, and they stay selectable because the reason to show
        a correlation ID at all is that someone will paste it somewhere.
    -->
    <Style
        x:Key="DesktopShift.MonospaceStyle"
        BasedOn="{StaticResource DesktopShift.BodyStyle}"
        TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

    <Style x:Key="DesktopShift.CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DesktopShift.SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DesktopShift.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource DesktopShift.CardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource DesktopShift.CardPadding}" />
    </Style>

    <Style
        x:Key="DesktopShift.GroupCardStyle"
        BasedOn="{StaticResource DesktopShift.CardStyle}"
        TargetType="Border">
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style
        x:Key="DesktopShift.ListCardStyle"
        BasedOn="{StaticResource DesktopShift.CardStyle}"
        TargetType="Border">
        <Setter Property="MinHeight" Value="78" />
        <Setter Property="Padding" Value="15,13" />
    </Style>

    <Style x:Key="DesktopShift.SettingRowStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="68" />
        <Setter Property="Padding" Value="15,12" />
        <Setter Property="BorderBrush" Value="{ThemeResource DesktopShift.BorderBrush}" />
    </Style>

    <Style
        x:Key="DesktopShift.RowTitleStyle"
        BasedOn="{StaticResource DesktopShift.BodyStyle}"
        TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style
        x:Key="DesktopShift.RowDescriptionStyle"
        BasedOn="{StaticResource DesktopShift.CaptionStyle}"
        TargetType="TextBlock">
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!--
        Pills and badges carry a hairline outline. In the ordinary themes it is
        barely there; in a high-contrast theme the soft accent fill collapses
        onto the window colour, and the outline is the only thing left that says
        where the badge ends.
    -->
    <Style x:Key="DesktopShift.PillStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DesktopShift.AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DesktopShift.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource DesktopShift.PillCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource DesktopShift.PillPadding}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="DesktopShift.BadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DesktopShift.AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DesktopShift.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource DesktopShift.ControlCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource DesktopShift.BadgePadding}" />
    </Style>

    <Style x:Key="DesktopShift.PillTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource DesktopShift.TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The rounded accent square that carries a card's Fluent glyph. -->
    <Style x:Key="DesktopShift.IconTileStyle" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource DesktopShift.IconTileSize}" />
        <Setter Property="Height" Value="{StaticResource DesktopShift.IconTileSize}" />
        <Setter Property="Background" Value="{ThemeResource DesktopShift.AccentSoftBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource DesktopShift.CardCornerRadius}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!--
        The glyph inside a tile repeats the heading beside it, so it is hidden
        from assistive technology rather than announced twice.
    -->
    <Style x:Key="DesktopShift.IconTileGlyphStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource DesktopShift.AccentStrongBrush}" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
    </Style>

    <Style x:Key="DesktopShift.MetricStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource DesktopShift.AccentStrongBrush}" />
    </Style>

    <Style x:Key="DesktopShift.EmptyStateIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="Foreground" Value="{ThemeResource DesktopShift.AccentBrush}" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
    </Style>

    <!--
        A hairline rule. It is decoration, so it is kept out of the accessibility
        tree entirely; the heading after it already says a new section started.
    -->
    <Style x:Key="DesktopShift.SeparatorStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{ThemeResource DesktopShift.BorderBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
    </Style>

    <!--
        Cards in a list carry their own surface, so the row must not draw one.
        The setters stay to properties this dictionary owns, exactly as the
        per-page item styles did before them: an explicit style on a templated
        control is a delicate thing, and none of this needs to touch the
        template WinUI already supplies.
    -->
    <Style x:Key="DesktopShift.CardListItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="CornerRadius" Value="{StaticResource DesktopShift.CardCornerRadius}" />
    </Style>
</ResourceDictionary>
