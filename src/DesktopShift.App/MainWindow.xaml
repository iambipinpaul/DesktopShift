<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DesktopShift.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="DesktopShift">

    <Grid x:Name="RootLayout" Background="{ThemeResource DesktopShift.WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Background="{ThemeResource DesktopShift.TitleBarBackgroundBrush}"
            AutomationProperties.Name="DesktopShift title bar">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="138" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="{StaticResource DesktopShift.ItemSpacing}">
                <Image
                    Width="27"
                    Height="27"
                    AutomationProperties.AccessibilityView="Raw"
                    Source="ms-appx:///Assets/DesktopShiftLogo.svg"
                    Stretch="Uniform" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI Variable Display"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource DesktopShift.TextPrimaryBrush}"
                    Text="DesktopShift" />
            </StackPanel>

            <!--
                A tagline, not information. The window already announces its own
                name, so repeating a slogan into a screen reader would only get
                between the user and the navigation.
            -->
            <TextBlock
                Grid.Column="1"
                Margin="16,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                FontFamily="Segoe UI Variable Text"
                FontSize="11"
                Foreground="{ThemeResource DesktopShift.TextSecondaryBrush}"
                Text="Windows workspace companion"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <NavigationView
            x:Name="ShellNavigation"
            Grid.Row="1"
            AlwaysShowHeader="False"
            AutomationProperties.Name="Primary navigation"
            Background="{ThemeResource DesktopShift.PaneBackgroundBrush}"
            DisplayModeChanged="OnNavigationDisplayModeChanged"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="284"
            PaneDisplayMode="Auto"
            SelectionChanged="OnNavigationSelectionChanged">

            <NavigationView.PaneHeader>
                <StackPanel Margin="21,16,16,14" Spacing="15">
                    <Grid ColumnSpacing="11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Width="44"
                            Height="44"
                            AutomationProperties.AccessibilityView="Raw"
                            Source="ms-appx:///Assets/DesktopShiftLogo.svg"
                            Stretch="Uniform" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock
                                FontFamily="Segoe UI Variable Display"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource DesktopShift.TextPrimaryBrush}"
                                Text="DesktopShift" />
                            <TextBlock
                                Style="{StaticResource DesktopShift.CaptionStyle}"
                                Text="Workspace settings" />
                        </StackPanel>
                    </Grid>
                    <AutoSuggestBox
                        x:Name="SettingsSearchBox"
                        Height="34"
                        AutomationProperties.Name="Find a setting"
                        PlaceholderText="Find a setting"
                        QueryIcon="Find" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="OverviewNavigationItem"
                    AutomationProperties.Name="Home"
                    Content="Home"
                    IsSelected="True"
                    Margin="8,0,4,0"
                    Tag="overview">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.Name="Application rules" Content="Application rules" Margin="8,0,4,0" Tag="rules">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EF;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.Name="Managed desktops" Content="Managed desktops" Margin="8,0,4,0" Tag="desktops">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.Name="Assignment Activity" Content="Activity" Margin="8,0,4,0" Tag="activity">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem AutomationProperties.Name="System settings" Content="System settings" Margin="8,0,4,0" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.Name="About DesktopShift" Content="About" Margin="8,0,4,0" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame
                x:Name="ContentFrame"
                AutomationProperties.Name="Page content"
                Background="{ThemeResource DesktopShift.WindowBackgroundBrush}" />
        </NavigationView>
    </Grid>
</Window>
