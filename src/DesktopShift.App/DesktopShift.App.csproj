<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <RootNamespace>DesktopShift.App</RootNamespace>
    <AssemblyName>DesktopShift</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' != 'ARM64'">win-x64</RuntimeIdentifier>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AppxBundle>Never</AppxBundle>
    <AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
    <AppxPackageSigningEnabled Condition="'$(AppxPackageSigningEnabled)' == ''">false</AppxPackageSigningEnabled>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxPackageDir Condition="'$(AppxPackageDir)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\packages\</AppxPackageDir>
    <GenerateTestArtifacts>false</GenerateTestArtifacts>
    <Product>DesktopShift</Product>
    <Company>Bipin Paul</Company>
    <Authors>Bipin Paul</Authors>
    <Description>Automatically assign application windows to managed Windows Virtual Desktops.</Description>
    <Copyright>© 2026 Bipin Paul. All rights reserved.</Copyright>
    <AppxPackageVersion Condition="'$(AppxPackageVersion)' == ''">1.0.0.0</AppxPackageVersion>
    <Version>1.0.0</Version>
    <FileVersion>$(AppxPackageVersion)</FileVersion>
    <AssemblyVersion>$(AppxPackageVersion)</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DesktopShift.Core\DesktopShift.Core.csproj" />
    <ProjectReference Include="..\DesktopShift.Infrastructure\DesktopShift.Infrastructure.csproj" />
    <ProjectReference Include="..\DesktopShift.Windows\DesktopShift.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None
      Include="..\DesktopShift.NativeBridge\bin\$(Platform)\$(Configuration)\DesktopShift.NativeBridge.dll"
      Link="DesktopShift.NativeBridge.dll"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\DesktopShiftLogo.svg" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!--
    The AppX tooling reads the package version from the manifest, but release
    automation needs to provide it without modifying a tracked file. Generate
    an intermediate manifest and point the packaging targets at that copy.
  -->
  <Target
    Name="GenerateVersionedPackageManifest"
    BeforeTargets="_ValidatePresenceOfAppxManifestItems"
    Condition="'$(GenerateAppxPackageOnBuild)' == 'true'">
    <PropertyGroup>
      <_VersionedPackageManifest>$(IntermediateOutputPath)VersionedPackage.appxmanifest</_VersionedPackageManifest>
      <_IsValidAppxPackageVersion>$([System.Text.RegularExpressions.Regex]::IsMatch('$(AppxPackageVersion)', '^\d{1,5}\.\d{1,5}\.\d{1,5}\.\d{1,5}$'))</_IsValidAppxPackageVersion>
      <_PackageProcessorArchitecture Condition="'$(Platform)' == 'x64'">x64</_PackageProcessorArchitecture>
      <_PackageProcessorArchitecture Condition="'$(Platform)' == 'ARM64'">arm64</_PackageProcessorArchitecture>
    </PropertyGroup>
    <Error
      Condition="'$(_IsValidAppxPackageVersion)' != 'True'"
      Text="AppxPackageVersion must contain four numeric components (for example, 1.2.3.4)." />
    <Error
      Condition="'$(_PackageProcessorArchitecture)' == ''"
      Text="Platform must be x64 or ARM64 when constructing an MSIX package." />
    <Copy
      SourceFiles="@(AppxManifest)"
      DestinationFiles="$(_VersionedPackageManifest)" />
    <XmlPoke
      XmlInputPath="$(_VersionedPackageManifest)"
      Query="/*[local-name()='Package']/*[local-name()='Identity']/@Version"
      Value="$(AppxPackageVersion)" />
    <XmlPoke
      XmlInputPath="$(_VersionedPackageManifest)"
      Query="/*[local-name()='Package']/*[local-name()='Identity']/@ProcessorArchitecture"
      Value="$(_PackageProcessorArchitecture)" />
    <ItemGroup>
      <AppxManifest Remove="@(AppxManifest)" />
      <AppxManifest Include="$(_VersionedPackageManifest)" />
    </ItemGroup>
  </Target>
</Project>
