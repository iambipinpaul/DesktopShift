<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="DesktopShift.App.Rules.RuleEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:config="using:DesktopShift.Core.Configuration"
    xmlns:rules="using:DesktopShift.App.Rules"
    Width="960"
    MinWidth="0"
    MaxWidth="1040"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    AutomationProperties.Name="Application rule editor"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonText="Save rule"
    Title="{x:Bind ViewModel.Title}">

    <ContentDialog.Resources>
        <!-- WinUI caps ContentDialog at 548px unless its template resources are
             overridden. Keep the editor wide enough for its three-column form. -->
        <x:Double x:Key="ContentDialogMinWidth">320</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">1040</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="660" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="0">
            <TextBlock
                Margin="0,0,0,14"
                Style="{StaticResource DesktopShift.PageSubtitleStyle}"
                Text="Choose an application identity and the desktop where its windows belong." />

            <InfoBar
                Margin="0,0,0,14"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="Rule validation issues"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasValidationIssues, Mode=OneWay}"
                Message="{x:Bind ViewModel.ValidationSummary, Mode=OneWay}"
                Severity="Error"
                Title="This rule cannot be saved yet" />

            <InfoBar
                Margin="0,0,0,14"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="Rule save failure"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasSaveError, Mode=OneWay}"
                Message="{x:Bind ViewModel.SaveError, Mode=OneWay}"
                Severity="Error"
                Title="The rule was not saved" />

            <Border
                Margin="0,0,0,14"
                Padding="15"
                Style="{StaticResource DesktopShift.CardStyle}">
                <StackPanel Spacing="{StaticResource DesktopShift.GroupSpacing}">
                    <TextBlock Style="{StaticResource DesktopShift.SectionHeadingStyle}" Text="Identify the application" />
                    <TextBlock
                        Style="{StaticResource DesktopShift.CaptionStyle}"
                        Text="Choose a running application, browse for its executable, or type the identities by hand below. A packaged identity is stronger than a process name, which any application can share." />
                    <Grid ColumnSpacing="{StaticResource DesktopShift.ItemSpacing}" RowSpacing="{StaticResource DesktopShift.ItemSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="136" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Running applications"
                            Header="Running applications"
                            ItemsSource="{x:Bind ViewModel.RunningApplications}"
                            SelectedIndex="{x:Bind ViewModel.SelectedRunningApplicationIndex, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="config:RunningApplicationCandidate">
                                    <StackPanel Padding="0,4" Spacing="{StaticResource DesktopShift.TightSpacing}">
                                        <TextBlock Style="{StaticResource DesktopShift.BodyStyle}" Text="{x:Bind DisplayName}" />
                                        <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="{x:Bind Summary}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Refresh running applications"
                            Click="OnRefreshRunningApplicationsClick"
                            Content="Refresh" />
                        <Button
                            Grid.Row="1"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Use the selected running application"
                            Click="OnUseRunningApplicationClick"
                            Content="Use selected"
                            Style="{StaticResource AccentButtonStyle}" />
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="{StaticResource DesktopShift.GroupSpacing}">
                            <Button
                                AutomationProperties.Name="Browse for an executable"
                                Click="OnBrowseForExecutableClick"
                                Content="Browse for executable" />
                            <ProgressRing
                                Width="18"
                                Height="18"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Reading running windows"
                                IsActive="{x:Bind ViewModel.IsLoadingRunningApplications, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource DesktopShift.CaptionStyle}"
                                Text="{x:Bind ViewModel.RunningApplicationStatus, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="{StaticResource DesktopShift.SectionSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            Content="Also pin to this installation's path"
                            IsChecked="{x:Bind ViewModel.IncludeExecutablePath, Mode=TwoWay}" />
                        <CheckBox
                            Grid.Column="1"
                            Content="Also narrow to its window classes"
                            IsChecked="{x:Bind ViewModel.IncludeWindowClasses, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid
                Margin="0,0,0,14"
                ColumnSpacing="{StaticResource DesktopShift.GroupSpacing}"
                RowSpacing="{StaticResource DesktopShift.GroupSpacing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="{StaticResource DesktopShift.TightSpacing}">
                    <TextBox
                        AutomationProperties.Name="Name"
                        Header="Name"
                        Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Style="{StaticResource DesktopShift.CaptionStyle}"
                        Text="{x:Bind ViewModel.DisplayNameError, Mode=OneWay}"
                        Visibility="{x:Bind rules:RuleIconSource.TextVisibility(ViewModel.DisplayNameError), Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="{StaticResource DesktopShift.TightSpacing}">
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        AutomationProperties.HelpText="Choose a Managed Desktop, or Anywhere to leave this app wherever it opens."
                        AutomationProperties.Name="Destination"
                        DisplayMemberPath="DisplayName"
                        Header="Destination"
                        ItemsSource="{x:Bind ViewModel.ManagedDesktops}"
                        SelectedIndex="{x:Bind ViewModel.SelectedDesktopIndex, Mode=TwoWay}" />
                    <TextBlock
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Style="{StaticResource DesktopShift.CaptionStyle}"
                        Text="{x:Bind ViewModel.TargetDesktopError, Mode=OneWay}"
                        Visibility="{x:Bind rules:RuleIconSource.TextVisibility(ViewModel.TargetDesktopError), Mode=OneWay}" />
                </StackPanel>
                <ToggleSwitch
                    Grid.Column="2"
                    VerticalAlignment="Bottom"
                    AutomationProperties.HelpText="A disabled rule stops naming its app, and a window no rule names is moved to the first desktop. To leave an app alone instead, set its destination to Anywhere."
                    AutomationProperties.Name="Rule enabled"
                    IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}"
                    OffContent="Disabled"
                    OnContent="Enabled" />
                <StackPanel
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Spacing="{StaticResource DesktopShift.TightSpacing}">
                    <TextBox
                        MinHeight="70"
                        AcceptsReturn="True"
                        AutomationProperties.HelpText="One executable file name per line, for example Code.exe."
                        AutomationProperties.Name="Process names"
                        Header="Process names"
                        PlaceholderText="Code.exe"
                        Text="{x:Bind ViewModel.ProcessNames, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Style="{StaticResource DesktopShift.CaptionStyle}"
                        Text="{x:Bind ViewModel.ProcessNamesError, Mode=OneWay}"
                        Visibility="{x:Bind rules:RuleIconSource.TextVisibility(ViewModel.ProcessNamesError), Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <TextBlock
                Margin="0,0,0,14"
                Style="{StaticResource DesktopShift.CaptionStyle}"
                Text="A window that no enabled rule names is moved to the first desktop. Choose Anywhere to leave an app exactly where it opens — disabling a rule does not do that, it unmanages the app instead." />

            <InfoBar
                Margin="0,0,0,14"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="Windows Settings placement note"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasSystemSettingsPlacementNote, Mode=OneWay}"
                Message="{x:Bind ViewModel.SystemSettingsPlacementNote, Mode=OneWay}"
                Severity="Informational"
                Title="Windows Settings reuses its window" />

            <Expander
                Margin="0,0,0,14"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="Advanced"
                Header="Advanced">
                <StackPanel Padding="0,10,0,4" Spacing="{StaticResource DesktopShift.CardSpacing}">
                    <StackPanel Spacing="{StaticResource DesktopShift.TightSpacing}">
                        <TextBox
                            MinHeight="60"
                            AcceptsReturn="True"
                            AutomationProperties.HelpText="One package family name per line, in the form Name_PublisherId."
                            AutomationProperties.Name="Package family names"
                            Header="Package family names"
                            PlaceholderText="Microsoft.WindowsTerminal_8wekyb3d8bbwe"
                            Text="{x:Bind ViewModel.PackageFamilyNames, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Style="{StaticResource DesktopShift.CaptionStyle}"
                            Text="{x:Bind ViewModel.PackageFamilyNamesError, Mode=OneWay}"
                            Visibility="{x:Bind rules:RuleIconSource.TextVisibility(ViewModel.PackageFamilyNamesError), Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Spacing="{StaticResource DesktopShift.TightSpacing}">
                        <TextBox
                            MinHeight="60"
                            AcceptsReturn="True"
                            AutomationProperties.Name="AppUserModelIds"
                            Header="AppUserModelIds"
                            PlaceholderText="Microsoft.WindowsTerminal_8wekyb3d8bbwe!App"
                            Text="{x:Bind ViewModel.AppUserModelIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Style="{StaticResource DesktopShift.CaptionStyle}"
                            Text="{x:Bind ViewModel.AppUserModelIdsError, Mode=OneWay}"
                            Visibility="{x:Bind rules:RuleIconSource.TextVisibility(ViewModel.AppUserModelIdsError), Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Spacing="{StaticResource DesktopShift.TightSpacing}">
                        <TextBox
                            MinHeight="60"
                            AcceptsReturn="True"
                            AutomationProperties.HelpText="One full path per line. A path pins the rule to a single installation."
                            AutomationProperties.Name="Executable paths"
                            Header="Executable paths"
                            PlaceholderText="C:\Windows\System32\mstsc.exe"
                            Text="{x:Bind ViewModel.ExecutablePaths, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Style="{StaticResource DesktopShift.CaptionStyle}"
                            Text="{x:Bind ViewModel.ExecutablePathsError, Mode=OneWay}"
                            Visibility="{x:Bind rules:RuleIconSource.TextVisibility(ViewModel.ExecutablePathsError), Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Spacing="{StaticResource DesktopShift.TightSpacing}">
                        <TextBox
                            MinHeight="60"
                            AcceptsReturn="True"
                            AutomationProperties.HelpText="A window class narrows the rule to one window shape. It never identifies an application on its own."
                            AutomationProperties.Name="Window classes"
                            Header="Window classes"
                            PlaceholderText="TscShellContainerClass"
                            Text="{x:Bind ViewModel.WindowClasses, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Style="{StaticResource DesktopShift.CaptionStyle}"
                            Text="{x:Bind ViewModel.WindowClassesError, Mode=OneWay}"
                            Visibility="{x:Bind rules:RuleIconSource.TextVisibility(ViewModel.WindowClassesError), Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Spacing="{StaticResource DesktopShift.TightSpacing}">
                        <TextBox
                            AutomationProperties.HelpText="Letters, digits, hyphens, underscores, and periods only."
                            AutomationProperties.Name="Identifier"
                            Header="Identifier"
                            Text="{x:Bind ViewModel.Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Style="{StaticResource DesktopShift.CaptionStyle}"
                            Text="{x:Bind ViewModel.IdError, Mode=OneWay}"
                            Visibility="{x:Bind rules:RuleIconSource.TextVisibility(ViewModel.IdError), Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Spacing="{StaticResource DesktopShift.TightSpacing}" Visibility="{x:Bind rules:RuleIconSource.WhenTrue(ViewModel.IsPlacementConfigurable), Mode=OneWay}">
                        <TextBlock Style="{StaticResource DesktopShift.FieldLabelStyle}" Text="Triggers" />
                        <StackPanel AutomationProperties.Name="Triggers" Spacing="{StaticResource DesktopShift.TightSpacing}">
                            <CheckBox Content="Window created" IsChecked="{x:Bind ViewModel.TriggerWindowCreated, Mode=TwoWay}" />
                            <CheckBox Content="Window shown" IsChecked="{x:Bind ViewModel.TriggerWindowShown, Mode=TwoWay}" />
                            <CheckBox Content="Foreground activated" IsChecked="{x:Bind ViewModel.TriggerForegroundActivated, Mode=TwoWay}" />
                            <CheckBox Content="Startup reconciliation" IsChecked="{x:Bind ViewModel.TriggerStartupReconciliation, Mode=TwoWay}" />
                            <CheckBox Content="Manual reassignment" IsChecked="{x:Bind ViewModel.TriggerManualReassignment, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Style="{StaticResource DesktopShift.CaptionStyle}"
                            Text="{x:Bind ViewModel.TriggersError, Mode=OneWay}"
                            Visibility="{x:Bind rules:RuleIconSource.TextVisibility(ViewModel.TriggersError), Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Spacing="{StaticResource DesktopShift.TightSpacing}" Visibility="{x:Bind rules:RuleIconSource.WhenTrue(ViewModel.IsPlacementConfigurable), Mode=OneWay}">
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Desktop switch policy"
                            Header="Desktop switch policy"
                            SelectedIndex="{x:Bind ViewModel.SwitchPolicyIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Never switch desktop" />
                            <ComboBoxItem Content="Switch on foreground activation" />
                            <ComboBoxItem Content="Switch on a new window's first activation" />
                        </ComboBox>
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Style="{StaticResource DesktopShift.CaptionStyle}"
                            Text="{x:Bind ViewModel.SwitchPolicyError, Mode=OneWay}"
                            Visibility="{x:Bind rules:RuleIconSource.TextVisibility(ViewModel.SwitchPolicyError), Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <StackPanel Spacing="{StaticResource DesktopShift.ItemSpacing}">
                <Button
                    AutomationProperties.Name="Test rule against open windows"
                    Click="OnTestRuleClick"
                    Content="Test rule against open windows" />
            <InfoBar
                Margin="0,0,0,14"
                AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="Rule test result"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasTestResult, Mode=OneWay}"
                    Message="{x:Bind ViewModel.TestDetails, Mode=OneWay}"
                    Severity="Informational"
                    Title="{x:Bind ViewModel.TestSummary, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
