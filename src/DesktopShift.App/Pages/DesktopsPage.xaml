<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DesktopShift.App.Pages.DesktopsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:desktops="using:DesktopShift.App.Desktops"
    xmlns:viewModels="using:DesktopShift.App.ViewModels"
    AutomationProperties.Name="Managed desktops page"
    Background="Transparent">
    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="{StaticResource DesktopShift.PageContentMaxWidth}"
            Margin="{StaticResource DesktopShift.PageMargin}"
            HorizontalAlignment="Center"
            Spacing="{StaticResource DesktopShift.SectionSpacing}">
            <StackPanel Margin="0,0,0,-12" Orientation="Horizontal" Spacing="7">
                <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="DesktopShift" />
                <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="›" />
                <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="Managed desktops" />
            </StackPanel>
            <StackPanel Spacing="{StaticResource DesktopShift.TightSpacing}">
                <TextBlock Style="{StaticResource DesktopShift.PageTitleStyle}" Text="Managed desktops" />
                <TextBlock
                    Style="{StaticResource DesktopShift.PageSubtitleStyle}"
                    Text="Semantic destinations remain stable even when Windows desktop identities change." />
            </StackPanel>

            <StackPanel
                x:Name="ManagedMappingsPanel"
                AutomationProperties.Name="Managed desktop definitions"
                Spacing="{StaticResource DesktopShift.GroupSpacing}"
                Visibility="Collapsed">
                <Border Style="{StaticResource DesktopShift.CardStyle}">
                    <StackPanel Spacing="{StaticResource DesktopShift.CardSpacing}">
                        <Grid ColumnSpacing="{StaticResource DesktopShift.CardSpacing}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="{StaticResource DesktopShift.TightSpacing}">
                                <TextBlock
                                    Style="{StaticResource DesktopShift.SectionHeadingStyle}"
                                    Text="Managed destinations" />
                                <TextBlock
                                    x:Name="ManagedMappingSummary"
                                    Style="{StaticResource DesktopShift.PageSubtitleStyle}" />
                                <TextBlock
                                    x:Name="ManagedMappingProvider"
                                    Style="{StaticResource DesktopShift.CaptionStyle}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Spacing="{StaticResource DesktopShift.TightSpacing}">
                                <TextBlock
                                    x:Name="ManagedMappingOutcome"
                                    HorizontalAlignment="Right"
                                    Foreground="{ThemeResource DesktopShift.AccentStrongBrush}"
                                    Style="{StaticResource DesktopShift.SectionTitleStyle}" />
                                <TextBlock
                                    x:Name="ManagedMappingObservedAt"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource DesktopShift.CaptionStyle}" />
                            </StackPanel>
                        </Grid>
                        <!--
                            The name and the visibility live on the scroller, not
                            on the row inside it. Collapsing only the row would
                            leave an empty scroller behind, and the card would
                            keep a band of blank space in Limited Mode where the
                            commands are never shown at all.
                        -->
                        <ScrollViewer
                            x:Name="MaintenanceCommands"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource DesktopShift.GroupSpacing}">
                                <Button
                                    x:Name="AddDesktopButton"
                                    AutomationProperties.Name="Add a managed desktop"
                                    Click="OnAddDesktopClick"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource DesktopShift.ItemSpacing}">
                                        <FontIcon
                                            AutomationProperties.AccessibilityView="Raw"
                                            FontSize="14"
                                            Glyph="&#xE710;" />
                                        <TextBlock Text="Add managed desktop" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="ReconcileAllButton"
                                    AutomationProperties.Name="Reconcile all runtime mappings"
                                    Click="OnReconcileAllClick">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource DesktopShift.ItemSpacing}">
                                        <FontIcon
                                            AutomationProperties.AccessibilityView="Raw"
                                            FontSize="14"
                                            Glyph="&#xE895;" />
                                        <TextBlock Text="Reconcile all" />
                                    </StackPanel>
                                </Button>
                                <ProgressRing
                                    x:Name="MaintenanceProgress"
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Applying the requested change"
                                    IsActive="False"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <InfoBar
                    x:Name="OperationResult"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="Result of the last managed desktop change"
                    IsClosable="True"
                    IsOpen="False"
                    IsTabStop="False" />

                <ItemsControl
                    x:Name="ValidationList"
                    AutomationProperties.Name="Managed desktop validation">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="desktops:ManagedDesktopValidationItem">
                            <InfoBar
                                Margin="0,0,0,8"
                                IsClosable="False"
                                IsOpen="True"
                                IsTabStop="False"
                                Message="{x:Bind Message}"
                                Severity="{x:Bind Severity}"
                                Title="{x:Bind Title}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ListView
                    x:Name="ManagedMappingList"
                    AutomationProperties.Name="Managed desktop definitions"
                    ItemContainerStyle="{StaticResource DesktopShift.CardListItemStyle}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="desktops:ManagedDesktopCatalogItem">
                            <Border
                                AutomationProperties.Name="{x:Bind AutomationName}"
                                Style="{StaticResource DesktopShift.CardStyle}">
                                <Grid ColumnSpacing="{StaticResource DesktopShift.CardSpacing}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!--
                                        The card's own name already reads out the
                                        preferred position, so the numbered disc
                                        is decoration and stays out of the
                                        accessibility tree rather than announcing
                                        the number a second time.
                                    -->
                                    <Border
                                        Width="{StaticResource DesktopShift.IconTileSize}"
                                        Height="{StaticResource DesktopShift.IconTileSize}"
                                        VerticalAlignment="Top"
                                        AutomationProperties.AccessibilityView="Raw"
                                        Background="{ThemeResource DesktopShift.AccentSoftBrush}"
                                        CornerRadius="{StaticResource DesktopShift.PillCornerRadius}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource DesktopShift.AccentStrongBrush}"
                                            Style="{StaticResource DesktopShift.BodyStyle}"
                                            Text="{x:Bind Order}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="{StaticResource DesktopShift.ItemSpacing}">
                                        <Grid ColumnSpacing="{StaticResource DesktopShift.GroupSpacing}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="{StaticResource DesktopShift.TightSpacing}">
                                                <TextBlock
                                                    Style="{StaticResource DesktopShift.SectionTitleStyle}"
                                                    Text="{x:Bind DisplayName}" />
                                                <TextBlock
                                                    Style="{StaticResource DesktopShift.CaptionStyle}"
                                                    Text="{x:Bind SemanticKeyLabel}" />
                                            </StackPanel>
                                            <Border
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource DesktopShift.BadgeStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource DesktopShift.ItemSpacing}">
                                                    <FontIcon
                                                        AutomationProperties.AccessibilityView="Raw"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource DesktopShift.AccentStrongBrush}"
                                                        Glyph="{x:Bind StatusGlyph}" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource DesktopShift.AccentStrongBrush}"
                                                        Style="{StaticResource DesktopShift.CaptionStyle}"
                                                        Text="{x:Bind Status}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <TextBlock
                                            Style="{StaticResource DesktopShift.BodyStyle}"
                                            Text="{x:Bind RuntimeSummary}" />
                                        <TextBlock
                                            Style="{StaticResource DesktopShift.CaptionStyle}"
                                            Text="{x:Bind Explanation}" />
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource DesktopShift.ItemSpacing}">
                                            <TextBlock
                                                Style="{StaticResource DesktopShift.CaptionStyle}"
                                                Text="{x:Bind RuleSummary}" />
                                            <TextBlock
                                                AutomationProperties.AccessibilityView="Raw"
                                                Style="{StaticResource DesktopShift.CaptionStyle}"
                                                Text="&#x2022;" />
                                            <TextBlock
                                                Style="{StaticResource DesktopShift.CaptionStyle}"
                                                Text="{x:Bind RecreationPolicy}" />
                                        </StackPanel>
                                        <!--
                                            Five commands that say the same thing
                                            on every row, so each one carries the
                                            desktop's name as help text. The strip
                                            scrolls rather than clipping, because
                                            a command cut off by a narrow window
                                            cannot be reached by mouse or by Tab.
                                        -->
                                        <ScrollViewer
                                            HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                            Visibility="{x:Bind EditVisibility}">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource DesktopShift.ItemSpacing}">
                                                <Button
                                                    AutomationProperties.HelpText="{x:Bind DisplayName}"
                                                    AutomationProperties.Name="Rename this managed desktop"
                                                    Click="OnRenameClick"
                                                    Tag="{x:Bind SemanticKey}"
                                                    ToolTipService.ToolTip="Rename">
                                                    <FontIcon
                                                        AutomationProperties.AccessibilityView="Raw"
                                                        FontSize="14"
                                                        Glyph="&#xE70F;" />
                                                </Button>
                                                <Button
                                                    AutomationProperties.HelpText="{x:Bind DisplayName}"
                                                    AutomationProperties.Name="Move to an earlier preferred position"
                                                    Click="OnMoveEarlierClick"
                                                    IsEnabled="{x:Bind CanMoveEarlier}"
                                                    Tag="{x:Bind SemanticKey}"
                                                    ToolTipService.ToolTip="Move earlier">
                                                    <FontIcon
                                                        AutomationProperties.AccessibilityView="Raw"
                                                        FontSize="14"
                                                        Glyph="&#xE74A;" />
                                                </Button>
                                                <Button
                                                    AutomationProperties.HelpText="{x:Bind DisplayName}"
                                                    AutomationProperties.Name="Move to a later preferred position"
                                                    Click="OnMoveLaterClick"
                                                    IsEnabled="{x:Bind CanMoveLater}"
                                                    Tag="{x:Bind SemanticKey}"
                                                    ToolTipService.ToolTip="Move later">
                                                    <FontIcon
                                                        AutomationProperties.AccessibilityView="Raw"
                                                        FontSize="14"
                                                        Glyph="&#xE74B;" />
                                                </Button>
                                                <Button
                                                    AutomationProperties.HelpText="{x:Bind DisplayName}"
                                                    AutomationProperties.Name="{x:Bind RecreationToggleLabel}"
                                                    Click="OnToggleRecreationClick"
                                                    Tag="{x:Bind SemanticKey}"
                                                    ToolTipService.ToolTip="{x:Bind RecreationToggleLabel}">
                                                    <FontIcon
                                                        AutomationProperties.AccessibilityView="Raw"
                                                        FontSize="14"
                                                        Glyph="&#xE117;" />
                                                </Button>
                                                <Button
                                                    AutomationProperties.HelpText="{x:Bind DisplayName}"
                                                    AutomationProperties.Name="Recreate the missing Windows desktop"
                                                    Click="OnRecreateClick"
                                                    IsEnabled="{x:Bind CanRecreate}"
                                                    Tag="{x:Bind SemanticKey}"
                                                    ToolTipService.ToolTip="{x:Bind RecreateToolTip}">
                                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource DesktopShift.ItemSpacing}">
                                                        <FontIcon
                                                            AutomationProperties.AccessibilityView="Raw"
                                                            FontSize="14"
                                                            Glyph="&#xE7F4;" />
                                                        <TextBlock Text="Recreate" />
                                                    </StackPanel>
                                                </Button>
                                                <Button
                                                    AutomationProperties.HelpText="{x:Bind DisplayName}"
                                                    AutomationProperties.Name="Remove this managed desktop from management"
                                                    Click="OnRemoveClick"
                                                    Tag="{x:Bind SemanticKey}"
                                                    ToolTipService.ToolTip="Remove from management. The Windows desktop is kept.">
                                                    <FontIcon
                                                        AutomationProperties.AccessibilityView="Raw"
                                                        FontSize="14"
                                                        Glyph="&#xE738;" />
                                                </Button>
                                            </StackPanel>
                                        </ScrollViewer>
                                        <Expander
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            AutomationProperties.HelpText="{x:Bind DisplayName}"
                                            Header="Advanced mapping details">
                                            <!--
                                                No accessible name of its own: a
                                                name on a TextBlock replaces the
                                                text it is meant to introduce, and
                                                the expander this sits inside has
                                                already said what it holds.
                                            -->
                                            <TextBlock
                                                Padding="0,8,0,2"
                                                Style="{StaticResource DesktopShift.MonospaceStyle}"
                                                Text="{x:Bind AdvancedDetails}" />
                                        </Expander>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <Border
                x:Name="StatusCard"
                MinHeight="260"
                AutomationProperties.LiveSetting="Polite"
                Style="{StaticResource DesktopShift.CardStyle}">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="{StaticResource DesktopShift.GroupSpacing}">
                    <ProgressRing
                        x:Name="LoadingIndicator"
                        Width="28"
                        Height="28"
                        AutomationProperties.Name="Loading Windows desktop inventory"
                        IsActive="False"
                        Visibility="Collapsed" />
                    <FontIcon
                        x:Name="StatusIcon"
                        HorizontalAlignment="Center"
                        Style="{StaticResource DesktopShift.EmptyStateIconStyle}"
                        Glyph="&#xE7F4;" />
                    <TextBlock
                        x:Name="StatusTitle"
                        HorizontalAlignment="Center"
                        Style="{StaticResource DesktopShift.SectionHeadingStyle}"
                        TextAlignment="Center" />
                    <TextBlock
                        x:Name="StatusMessage"
                        MaxWidth="560"
                        Style="{StaticResource DesktopShift.PageSubtitleStyle}"
                        TextAlignment="Center" />
                    <TextBlock
                        x:Name="StatusProvider"
                        MaxWidth="560"
                        Style="{StaticResource DesktopShift.CaptionStyle}"
                        TextAlignment="Center" />
                </StackPanel>
            </Border>

            <StackPanel
                x:Name="InventoryPanel"
                Spacing="{StaticResource DesktopShift.GroupSpacing}"
                Visibility="Collapsed">
                <Grid>
                    <TextBlock
                        Style="{StaticResource DesktopShift.SectionHeadingStyle}"
                        Text="Runtime inventory" />
                    <TextBlock
                        x:Name="InventoryCount"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Windows desktop count"
                        Style="{StaticResource DesktopShift.CaptionStyle}" />
                </Grid>
                <ListView
                    x:Name="DesktopList"
                    AutomationProperties.Name="Windows desktop runtime inventory"
                    ItemContainerStyle="{StaticResource DesktopShift.CardListItemStyle}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:DesktopInventoryItemPresentation">
                            <Border
                                AutomationProperties.Name="{x:Bind AutomationName}"
                                Style="{StaticResource DesktopShift.CardStyle}">
                                <Grid ColumnSpacing="{StaticResource DesktopShift.CardSpacing}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource DesktopShift.IconTileStyle}">
                                        <FontIcon Style="{StaticResource DesktopShift.IconTileGlyphStyle}" Glyph="&#xE7F4;" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="{StaticResource DesktopShift.ItemSpacing}">
                                        <Grid ColumnSpacing="{StaticResource DesktopShift.GroupSpacing}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="{StaticResource DesktopShift.TightSpacing}">
                                                <TextBlock
                                                    Style="{StaticResource DesktopShift.SectionTitleStyle}"
                                                    Text="{x:Bind DisplayName}" />
                                                <TextBlock
                                                    Style="{StaticResource DesktopShift.CaptionStyle}"
                                                    Text="{x:Bind Position}" />
                                            </StackPanel>
                                            <Border
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource DesktopShift.BadgeStyle}"
                                                Visibility="{x:Bind CurrentVisibility}">
                                                <TextBlock
                                                    AutomationProperties.Name="Current Windows desktop"
                                                    Foreground="{ThemeResource DesktopShift.AccentStrongBrush}"
                                                    Style="{StaticResource DesktopShift.CaptionStyle}"
                                                    Text="{x:Bind CurrentLabel}" />
                                            </Border>
                                        </Grid>
                                        <Expander
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            AutomationProperties.HelpText="{x:Bind DisplayName}"
                                            Header="Advanced details">
                                            <StackPanel Padding="0,8,0,2" Spacing="{StaticResource DesktopShift.TightSpacing}">
                                                <TextBlock
                                                    Style="{StaticResource DesktopShift.FieldLabelStyle}"
                                                    Text="Desktop ID" />
                                                <TextBlock
                                                    Style="{StaticResource DesktopShift.MonospaceStyle}"
                                                    Text="{x:Bind DesktopId}" />
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
