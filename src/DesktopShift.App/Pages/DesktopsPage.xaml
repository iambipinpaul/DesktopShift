<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DesktopShift.App.Pages.DesktopsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:desktops="using:DesktopShift.App.Desktops"
    xmlns:viewModels="using:DesktopShift.App.ViewModels"
    AutomationProperties.Name="Managed desktops page"
    Background="Transparent"
    SizeChanged="OnPageSizeChanged">
    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            x:Name="DesktopsContent"
            MaxWidth="{StaticResource DesktopShift.PageContentMaxWidth}"
            Margin="{StaticResource DesktopShift.PageMargin}"
            HorizontalAlignment="Center">
            <StackPanel Margin="0,0,0,12" Orientation="Horizontal" Spacing="7">
                <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="DesktopShift" />
                <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="›" />
                <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="Managed desktops" />
            </StackPanel>

            <Grid
                x:Name="DesktopsHeaderGrid"
                Margin="0,0,0,22"
                ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource DesktopShift.PageTitleStyle}" Text="Managed desktops" />
                    <TextBlock
                        MaxWidth="700"
                        Style="{StaticResource DesktopShift.PageSubtitleStyle}"
                        Text="Semantic destinations remain stable even when Windows desktop identities change." />
                </StackPanel>
                <StackPanel
                    x:Name="MaintenanceCommands"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="Collapsed">
                    <Button
                        x:Name="AddDesktopButton"
                        AutomationProperties.Name="Add managed desktop"
                        Click="OnAddDesktopClick"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="Add desktop" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="ReconcileAllButton"
                        AutomationProperties.Name="Reconcile all managed desktops"
                        Click="OnReconcileAllClick">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            <TextBlock Text="Reconcile all" />
                        </StackPanel>
                    </Button>
                    <ProgressRing
                        x:Name="MaintenanceProgress"
                        Width="20"
                        Height="20"
                        IsActive="False"
                        Visibility="Collapsed" />
                </StackPanel>
            </Grid>

            <StackPanel
                x:Name="ManagedMappingsPanel"
                AutomationProperties.Name="Managed desktop definitions"
                Visibility="Collapsed">
                <Border Margin="0,0,0,14" Padding="18" Style="{StaticResource DesktopShift.CardStyle}">
                    <Grid x:Name="ManagedSummaryGrid" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border
                            Grid.RowSpan="2"
                            Width="44"
                            Height="44"
                            Style="{StaticResource DesktopShift.IconTileStyle}">
                            <FontIcon Style="{StaticResource DesktopShift.IconTileGlyphStyle}" Glyph="&#xE7F4;" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock
                                x:Name="ManagedMappingSummary"
                                Style="{StaticResource DesktopShift.SectionTitleStyle}" />
                            <TextBlock
                                x:Name="ManagedMappingProvider"
                                Style="{StaticResource DesktopShift.CaptionStyle}" />
                        </StackPanel>
                        <StackPanel
                            x:Name="ManagedSummaryStatus"
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            Spacing="5">
                            <Border HorizontalAlignment="Right" Style="{StaticResource DesktopShift.BadgeStyle}">
                                <TextBlock
                                    x:Name="ManagedMappingOutcome"
                                    Foreground="{ThemeResource DesktopShift.SuccessBrush}"
                                    Style="{StaticResource DesktopShift.BadgeTextStyle}" />
                            </Border>
                            <TextBlock
                                x:Name="ManagedMappingObservedAt"
                                HorizontalAlignment="Right"
                                Style="{StaticResource DesktopShift.CaptionStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <InfoBar
                    x:Name="OperationResult"
                    Margin="0,0,0,12"
                    AutomationProperties.LiveSetting="Polite"
                    IsClosable="True"
                    IsOpen="False" />

                <ListView
                    x:Name="ValidationList"
                    Margin="0,0,0,12"
                    AutomationProperties.Name="Managed desktop validation messages"
                    IsItemClickEnabled="False"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="desktops:ManagedDesktopValidationItem">
                            <InfoBar
                                Margin="0,0,0,6"
                                IsClosable="False"
                                IsOpen="True"
                                Message="{x:Bind Message}"
                                Severity="{x:Bind Severity}"
                                Title="{x:Bind Title}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ListView
                    x:Name="ManagedMappingList"
                    AutomationProperties.Name="Managed desktops"
                    ItemContainerStyle="{StaticResource DesktopShift.CardListItemStyle}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="desktops:ManagedDesktopCatalogItem">
                            <Border
                                AutomationProperties.Name="{x:Bind AutomationName}"
                                Style="{StaticResource DesktopShift.ListCardStyle}">
                                <Grid ColumnSpacing="14" SizeChanged="OnManagedDesktopCardSizeChanged">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border
                                        Grid.RowSpan="2"
                                        Width="36"
                                        Height="36"
                                        Style="{StaticResource DesktopShift.IconTileStyle}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource DesktopShift.AccentStrongBrush}"
                                            Text="{x:Bind Order}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                        <TextBlock Style="{StaticResource DesktopShift.RowTitleStyle}" Text="{x:Bind DisplayName}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="{x:Bind SemanticKeyLabel}" />
                                            <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="•" />
                                            <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="{x:Bind RuntimeSummary}" />
                                            <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="•" />
                                            <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="{x:Bind RuleSummary}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel
                                        x:Name="ManagedDesktopCardActions"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <ToggleSwitch
                                            AutomationProperties.Name="{x:Bind TilingAutomationName}"
                                            IsEnabled="{x:Bind CanConfigureTiling}"
                                            IsOn="{x:Bind IsTilingEnabled}"
                                            OffContent="Tiling off"
                                            OnContent="Tiling on"
                                            Tag="{x:Bind SemanticKey}"
                                            Toggled="OnDesktopTilingToggled" />
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                            <FontIcon
                                                FontSize="12"
                                                Foreground="{ThemeResource DesktopShift.SuccessBrush}"
                                                Glyph="{x:Bind StatusGlyph}" />
                                            <TextBlock
                                                Foreground="{ThemeResource DesktopShift.SuccessBrush}"
                                                Style="{StaticResource DesktopShift.CaptionStyle}"
                                                Text="{x:Bind Status}" />
                                        </StackPanel>
                                        <Button
                                            AutomationProperties.HelpText="{x:Bind DisplayName}"
                                            AutomationProperties.Name="Manage desktop"
                                            Visibility="{x:Bind EditVisibility}">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                                <TextBlock Text="Manage" />
                                            </StackPanel>
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem
                                                        Click="OnRenameClick"
                                                        Tag="{x:Bind SemanticKey}"
                                                        Text="Rename" />
                                                    <MenuFlyoutItem
                                                        Click="OnMoveEarlierClick"
                                                        IsEnabled="{x:Bind CanMoveEarlier}"
                                                        Tag="{x:Bind SemanticKey}"
                                                        Text="Move earlier" />
                                                    <MenuFlyoutItem
                                                        Click="OnMoveLaterClick"
                                                        IsEnabled="{x:Bind CanMoveLater}"
                                                        Tag="{x:Bind SemanticKey}"
                                                        Text="Move later" />
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem
                                                        Click="OnToggleRecreationClick"
                                                        Tag="{x:Bind SemanticKey}"
                                                        Text="{x:Bind RecreationToggleLabel}" />
                                                    <MenuFlyoutItem
                                                        Click="OnRecreateClick"
                                                        IsEnabled="{x:Bind CanRecreate}"
                                                        Tag="{x:Bind SemanticKey}"
                                                        Text="Recreate missing desktop" />
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem
                                                        Click="OnRemoveClick"
                                                        Tag="{x:Bind SemanticKey}"
                                                        Text="Stop managing" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid Margin="0,16,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Style="{StaticResource DesktopShift.SectionLabelStyle}"
                        Text="Live Windows desktops" />
                    <TextBlock
                        x:Name="InventoryCount"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource DesktopShift.CaptionStyle}" />
                </Grid>
                <Grid>
                    <Border
                        x:Name="StatusCard"
                        MinHeight="120"
                        AutomationProperties.Name="Desktop inventory status"
                        Style="{StaticResource DesktopShift.CardStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <ProgressRing x:Name="LoadingIndicator" Width="24" Height="24" IsActive="False" />
                            <FontIcon x:Name="StatusIcon" Style="{StaticResource DesktopShift.EmptyStateIconStyle}" />
                            <TextBlock x:Name="StatusTitle" Style="{StaticResource DesktopShift.RowTitleStyle}" />
                            <TextBlock x:Name="StatusMessage" Style="{StaticResource DesktopShift.CaptionStyle}" TextAlignment="Center" />
                            <TextBlock x:Name="StatusProvider" Style="{StaticResource DesktopShift.CaptionStyle}" TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border
                        x:Name="InventoryPanel"
                        Style="{StaticResource DesktopShift.GroupCardStyle}"
                        Visibility="Collapsed">
                        <ListView
                            x:Name="DesktopList"
                            AutomationProperties.Name="Windows desktop inventory"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="68" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:DesktopInventoryItemPresentation">
                                    <Border
                                        MinHeight="68"
                                        Padding="15,12"
                                        AutomationProperties.Name="{x:Bind AutomationName}"
                                        BorderBrush="{ThemeResource DesktopShift.BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                        <Grid ColumnSpacing="14" SizeChanged="OnInventoryRowSizeChanged">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition x:Name="CurrentActionColumn" Width="96" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <FontIcon
                                                Grid.RowSpan="2"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource DesktopShift.TextSecondaryBrush}"
                                                Glyph="&#xE7F4;" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock Style="{StaticResource DesktopShift.RowTitleStyle}" Text="{x:Bind DisplayName}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="{x:Bind Position}" />
                                                    <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="•" />
                                                    <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="{x:Bind DesktopId}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel
                                                x:Name="CurrentDesktopIndicator"
                                                Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                Visibility="{x:Bind CurrentVisibility}">
                                                <FontIcon
                                                    FontSize="11"
                                                    Foreground="{ThemeResource DesktopShift.SuccessBrush}"
                                                    Glyph="&#xE73E;" />
                                                <TextBlock
                                                    Foreground="{ThemeResource DesktopShift.SuccessBrush}"
                                                    Style="{StaticResource DesktopShift.CaptionStyle}"
                                                    Text="{x:Bind CurrentLabel}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
