<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DesktopShift.App.Pages.DesktopsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:DesktopShift.App.ViewModels"
    AutomationProperties.Name="Windows desktops page"
    Background="Transparent">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="960" Margin="32,28" HorizontalAlignment="Left" Spacing="20">
            <StackPanel Spacing="5">
                <TextBlock Style="{StaticResource DesktopShift.PageTitleStyle}" Text="Windows Desktops" />
                <TextBlock
                    Style="{StaticResource DesktopShift.PageSubtitleStyle}"
                    Text="Managed destinations and the live virtual desktops reported by the validated Windows provider." />
            </StackPanel>

            <StackPanel
                x:Name="ManagedMappingsPanel"
                AutomationProperties.Name="Managed desktop mappings"
                Spacing="10"
                Visibility="Collapsed">
                <Border Style="{StaticResource DesktopShift.CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock
                                Style="{StaticResource DesktopShift.SectionTitleStyle}"
                                Text="Managed destinations" />
                            <TextBlock
                                x:Name="ManagedMappingSummary"
                                TextWrapping="Wrap"
                                Style="{StaticResource DesktopShift.PageSubtitleStyle}" />
                            <TextBlock
                                x:Name="ManagedMappingProvider"
                                TextWrapping="Wrap"
                                Style="{StaticResource DesktopShift.CaptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="3">
                            <TextBlock
                                x:Name="ManagedMappingOutcome"
                                HorizontalAlignment="Right"
                                Foreground="{ThemeResource DesktopShift.AccentStrongBrush}"
                                Style="{StaticResource DesktopShift.SectionTitleStyle}" />
                            <TextBlock
                                x:Name="ManagedMappingObservedAt"
                                HorizontalAlignment="Right"
                                Style="{StaticResource DesktopShift.CaptionStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <InfoBar
                    x:Name="ManagedMappingIssues"
                    AutomationProperties.Name="Managed desktop mapping issues"
                    IsClosable="False"
                    IsOpen="False"
                    IsTabStop="False"
                    Severity="Warning"
                    Title="Mapping needs attention" />

                <ListView
                    x:Name="ManagedMappingList"
                    AutomationProperties.Name="Observable managed desktop mappings"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,10" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:ManagedDesktopMappingItemPresentation">
                            <Border
                                AutomationProperties.Name="{x:Bind AutomationName}"
                                Style="{StaticResource DesktopShift.CardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="36"
                                        Height="36"
                                        VerticalAlignment="Top"
                                        Background="{ThemeResource DesktopShift.AccentSoftBrush}"
                                        CornerRadius="18">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Bind AutomationName}"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource DesktopShift.AccentStrongBrush}"
                                            Text="{x:Bind Order}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock
                                                    Style="{StaticResource DesktopShift.SectionTitleStyle}"
                                                    Text="{x:Bind DisplayName}" />
                                                <TextBlock
                                                    Style="{StaticResource DesktopShift.CaptionStyle}"
                                                    Text="{x:Bind SemanticKeyLabel}" />
                                            </StackPanel>
                                            <Border
                                                Grid.Column="1"
                                                Padding="10,5"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource DesktopShift.AccentSoftBrush}"
                                                CornerRadius="8">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon
                                                        FontSize="12"
                                                        Foreground="{ThemeResource DesktopShift.AccentStrongBrush}"
                                                        Glyph="{x:Bind StatusGlyph}" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource DesktopShift.AccentStrongBrush}"
                                                        Style="{StaticResource DesktopShift.CaptionStyle}"
                                                        Text="{x:Bind Status}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <TextBlock
                                            TextWrapping="Wrap"
                                            Style="{StaticResource DesktopShift.BodyStyle}"
                                            Text="{x:Bind RuntimeSummary}" />
                                        <TextBlock
                                            TextWrapping="Wrap"
                                            Style="{StaticResource DesktopShift.CaptionStyle}"
                                            Text="{x:Bind Explanation}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                Style="{StaticResource DesktopShift.CaptionStyle}"
                                                Text="{x:Bind RuleSummary}" />
                                            <TextBlock
                                                AutomationProperties.AccessibilityView="Raw"
                                                Style="{StaticResource DesktopShift.CaptionStyle}"
                                                Text="•" />
                                            <TextBlock
                                                Style="{StaticResource DesktopShift.CaptionStyle}"
                                                Text="{x:Bind RecreationPolicy}" />
                                        </StackPanel>
                                        <Expander
                                            AutomationProperties.Name="{x:Bind DisplayName}"
                                            Header="Advanced mapping details">
                                            <TextBlock
                                                Padding="0,8,0,2"
                                                AutomationProperties.Name="Advanced managed desktop mapping details"
                                                FontFamily="Consolas"
                                                IsTextSelectionEnabled="True"
                                                TextWrapping="Wrap"
                                                Style="{StaticResource DesktopShift.BodyStyle}"
                                                Text="{x:Bind AdvancedDetails}" />
                                        </Expander>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <Border
                x:Name="StatusCard"
                AutomationProperties.LiveSetting="Polite"
                MinHeight="260"
                Style="{StaticResource DesktopShift.CardStyle}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <ProgressRing
                        x:Name="LoadingIndicator"
                        Width="28"
                        Height="28"
                        AutomationProperties.Name="Loading Windows desktop inventory"
                        IsActive="False"
                        Visibility="Collapsed" />
                    <FontIcon
                        x:Name="StatusIcon"
                        Style="{StaticResource DesktopShift.EmptyStateIconStyle}"
                        Glyph="&#xE7F4;" />
                    <TextBlock
                        x:Name="StatusTitle"
                        TextAlignment="Center"
                        Style="{StaticResource DesktopShift.SectionTitleStyle}" />
                    <TextBlock
                        x:Name="StatusMessage"
                        MaxWidth="560"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Style="{StaticResource DesktopShift.PageSubtitleStyle}" />
                    <TextBlock
                        x:Name="StatusProvider"
                        MaxWidth="560"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Style="{StaticResource DesktopShift.CaptionStyle}" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="InventoryPanel" Spacing="10" Visibility="Collapsed">
                <Grid>
                    <TextBlock
                        Style="{StaticResource DesktopShift.SectionTitleStyle}"
                        Text="Runtime inventory" />
                    <TextBlock
                        x:Name="InventoryCount"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Windows desktop count"
                        Style="{StaticResource DesktopShift.CaptionStyle}" />
                </Grid>
                <ListView
                    x:Name="DesktopList"
                    AutomationProperties.Name="Windows desktop runtime inventory"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,10" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:DesktopInventoryItemPresentation">
                            <Border
                                AutomationProperties.Name="{x:Bind AutomationName}"
                                Style="{StaticResource DesktopShift.CardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="42"
                                        Height="42"
                                        Background="{ThemeResource DesktopShift.AccentSoftBrush}"
                                        CornerRadius="10">
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AccessibilityView="Raw"
                                            Foreground="{ThemeResource DesktopShift.AccentStrongBrush}"
                                            Glyph="&#xE7F4;" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock
                                                    Style="{StaticResource DesktopShift.SectionTitleStyle}"
                                                    Text="{x:Bind DisplayName}" />
                                                <TextBlock
                                                    Style="{StaticResource DesktopShift.CaptionStyle}"
                                                    Text="{x:Bind Position}" />
                                            </StackPanel>
                                            <Border
                                                Grid.Column="1"
                                                Padding="10,5"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource DesktopShift.AccentSoftBrush}"
                                                CornerRadius="8"
                                                Visibility="{x:Bind CurrentVisibility}">
                                                <TextBlock
                                                    AutomationProperties.Name="Current Windows desktop"
                                                    Foreground="{ThemeResource DesktopShift.AccentStrongBrush}"
                                                    Style="{StaticResource DesktopShift.CaptionStyle}"
                                                    Text="{x:Bind CurrentLabel}" />
                                            </Border>
                                        </Grid>
                                        <Expander
                                            AutomationProperties.Name="{x:Bind DisplayName}"
                                            Header="Advanced details">
                                            <StackPanel Padding="0,8,0,2" Spacing="4">
                                                <TextBlock
                                                    Style="{StaticResource DesktopShift.CaptionStyle}"
                                                    Text="Desktop ID" />
                                                <TextBlock
                                                    AutomationProperties.Name="Desktop ID"
                                                    FontFamily="Consolas"
                                                    IsTextSelectionEnabled="True"
                                                    Style="{StaticResource DesktopShift.BodyStyle}"
                                                    Text="{x:Bind DesktopId}" />
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
