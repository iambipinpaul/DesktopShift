<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DesktopShift.App.Pages.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.Name="Activity page"
    Background="Transparent">
    <Grid Margin="32,28" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="5">
            <TextBlock Style="{StaticResource DesktopShift.PageTitleStyle}" Text="Activity" />
            <TextBlock
                MaxWidth="960"
                HorizontalAlignment="Left"
                Style="{StaticResource DesktopShift.PageSubtitleStyle}"
                Text="Recent decisions, window moves, desktop switches, and assignment results. DesktopShift records privacy-safe app identity only—never window titles, browser addresses, or command lines." />
        </StackPanel>

        <Border
            Grid.Row="1"
            Padding="16,12"
            AutomationProperties.Name="Activity filters"
            Style="{StaticResource DesktopShift.CardStyle}">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <ComboBox
                    x:Name="ResultFilter"
                    MinWidth="150"
                    AutomationProperties.Name="Filter by result"
                    Header="Result"
                    SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="All results" Tag="all" />
                    <ComboBoxItem Content="Succeeded" Tag="succeeded" />
                    <ComboBoxItem Content="Skipped" Tag="skipped" />
                    <ComboBoxItem Content="Failed" Tag="failed" />
                </ComboBox>
                <ComboBox
                    x:Name="ApplicationFilter"
                    MinWidth="180"
                    AutomationProperties.Name="Filter by application"
                    Header="Application"
                    SelectionChanged="OnFilterChanged" />
                <ComboBox
                    x:Name="RuleFilter"
                    MinWidth="180"
                    AutomationProperties.Name="Filter by rule"
                    Header="Rule"
                    SelectionChanged="OnFilterChanged" />
                <ComboBox
                    x:Name="DateFilter"
                    MinWidth="180"
                    AutomationProperties.Name="Filter by date or session"
                    Header="Date or session"
                    SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="All time" Tag="all" />
                    <ComboBoxItem Content="This session" Tag="session" />
                    <ComboBoxItem Content="Last hour" Tag="hour" />
                    <ComboBoxItem Content="Today" Tag="today" />
                    <ComboBoxItem Content="Last 7 days" Tag="week" />
                </ComboBox>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="CopyEventButton"
                    AutomationProperties.Name="Copy the selected event"
                    Click="OnCopyEventClick"
                    Content="Copy event"
                    IsEnabled="False" />
                <Button
                    x:Name="ClearActivityButton"
                    AutomationProperties.Name="Clear local activity"
                    Click="OnClearActivityClick"
                    Content="Clear local activity" />
                <Button
                    x:Name="OpenLogLocationButton"
                    AutomationProperties.Name="Open the log location"
                    Click="OnOpenLogLocationClick"
                    Content="Open log location"
                    IsEnabled="False" />
                <Button
                    x:Name="ExportBundleButton"
                    AutomationProperties.Name="Export a diagnostic bundle"
                    Click="OnExportBundleClick"
                    Content="Export diagnostics"
                    IsEnabled="False" />
            </StackPanel>
            <TextBlock
                x:Name="ActivityCount"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                AutomationProperties.LiveSetting="Polite"
                Style="{StaticResource DesktopShift.CaptionStyle}" />
        </Grid>

        <Grid Grid.Row="3">
            <ListView
                x:Name="ActivityList"
                AutomationProperties.Name="Recent activity"
                IsItemClickEnabled="False"
                SelectionChanged="OnSelectionChanged"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,2" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,4"
                            AutomationProperties.Name="{Binding AutomationName}"
                            Style="{StaticResource DesktopShift.CardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel MinWidth="120" Spacing="6">
                                    <Border
                                        Padding="10,5"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource DesktopShift.AccentSoftBrush}"
                                        CornerRadius="999">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource DesktopShift.TextPrimaryBrush}"
                                            Text="{Binding ResultLabel}" />
                                    </Border>
                                    <TextBlock
                                        Style="{StaticResource DesktopShift.CaptionStyle}"
                                        Text="{Binding Source}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="9">
                                    <Grid ColumnSpacing="12">
                                        <TextBlock
                                            Style="{StaticResource DesktopShift.SectionTitleStyle}"
                                            Text="{Binding Summary}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource DesktopShift.CaptionStyle}"
                                            Text="{Binding Timestamp}" />
                                    </Grid>
                                    <Grid ColumnSpacing="24" RowSpacing="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="Application" />
                                            <TextBlock Text="{Binding Application}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="Target desktop" />
                                            <TextBlock Text="{Binding Target}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Spacing="3">
                                            <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="Trigger" />
                                            <TextBlock Text="{Binding Trigger}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                                            <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="Duration" />
                                            <TextBlock Text="{Binding Duration}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Spacing="3">
                                            <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="Rule" />
                                            <TextBlock Text="{Binding Rule}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="3">
                                            <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="Window identity" />
                                            <TextBlock Text="{Binding Identity}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock
                                        IsTextSelectionEnabled="True"
                                        Style="{StaticResource DesktopShift.CaptionStyle}"
                                        Text="{Binding Correlation}" />
                                    <TextBlock
                                        Style="{StaticResource DesktopShift.CaptionStyle}"
                                        Text="{Binding ErrorDetails}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border
                x:Name="EmptyState"
                MinHeight="300"
                AutomationProperties.Name="No activity to show"
                Style="{StaticResource DesktopShift.CardStyle}">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
                    <FontIcon Glyph="&#xE9D9;" Style="{StaticResource DesktopShift.EmptyStateIconStyle}" />
                    <TextBlock Style="{StaticResource DesktopShift.SectionTitleStyle}" Text="Nothing to report" />
                    <TextBlock
                        x:Name="EmptyStateMessage"
                        MaxWidth="500"
                        Style="{StaticResource DesktopShift.PageSubtitleStyle}"
                        Text="Decisions, moves, switches, and assignment results will appear here with privacy-safe window identity."
                        TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="3"
            Margin="0,0,0,12"
            VerticalAlignment="Bottom"
            IsClosable="True"
            IsOpen="False" />
    </Grid>
</Page>
