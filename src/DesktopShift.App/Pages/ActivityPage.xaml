<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DesktopShift.App.Pages.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:diagnostics="using:DesktopShift.Core.Diagnostics"
    xmlns:rules="using:DesktopShift.App.Rules"
    AutomationProperties.Name="Activity page"
    Background="Transparent"
    SizeChanged="OnPageSizeChanged">
    <Grid
        x:Name="ActivityContent"
        MaxWidth="{StaticResource DesktopShift.PageContentMaxWidth}"
        Margin="{StaticResource DesktopShift.PageMargin}"
        HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <StackPanel Margin="0,0,0,12" Orientation="Horizontal" Spacing="7">
                <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="DesktopShift" />
                <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="›" />
                <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="Activity" />
            </StackPanel>
            <Grid
                x:Name="ActivityHeaderGrid"
                Margin="0,0,0,22"
                ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource DesktopShift.PageTitleStyle}" Text="Activity" />
                    <TextBlock
                        MaxWidth="700"
                        Style="{StaticResource DesktopShift.PageSubtitleStyle}"
                        Text="Privacy-safe assignment decisions from the current session." />
                </StackPanel>
                <StackPanel
                    x:Name="ActivityHeaderActions"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <ToggleSwitch
                        x:Name="RecordActivityToggle"
                        VerticalAlignment="Center"
                        AutomationProperties.HelpText="Stores routine DesktopShift activity locally for troubleshooting. Nothing is uploaded."
                        AutomationProperties.Name="Record local activity"
                        IsEnabled="False"
                        OffContent="Off"
                        OnContent="On"
                        Toggled="OnRecordActivityToggled" />
                    <Button
                        x:Name="ClearActivityButton"
                        AutomationProperties.Name="Clear local activity"
                        Click="OnClearActivityClick"
                        Content="Clear local activity" />
                    <Button
                        x:Name="ExportBundleButton"
                        AutomationProperties.Name="Export a diagnostic bundle"
                        Click="OnExportBundleClick"
                        Content="Export diagnostics"
                        IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <Border
            Grid.Row="1"
            Margin="0,0,0,14"
            Padding="12"
            AutomationProperties.Name="Activity filters"
            Style="{StaticResource DesktopShift.GroupCardStyle}">
            <Grid
                x:Name="ActivityFilterGrid"
                ColumnSpacing="10"
                RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FilterColumn0" Width="*" />
                    <ColumnDefinition x:Name="FilterColumn1" Width="*" />
                    <ColumnDefinition x:Name="FilterColumn2" Width="*" />
                    <ColumnDefinition x:Name="FilterColumn3" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ComboBox
                    x:Name="ResultFilter"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Filter by result"
                    SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="All results" Tag="all" />
                    <ComboBoxItem Content="Succeeded" Tag="succeeded" />
                    <ComboBoxItem Content="Skipped" Tag="skipped" />
                    <ComboBoxItem Content="Failed" Tag="failed" />
                </ComboBox>
                <ComboBox
                    x:Name="ApplicationFilter"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Filter by application"
                    SelectionChanged="OnFilterChanged" />
                <ComboBox
                    x:Name="RuleFilter"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Filter by rule"
                    SelectionChanged="OnFilterChanged" />
                <ComboBox
                    x:Name="DateFilter"
                    Grid.Column="3"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Filter by date or session"
                    SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="All time" Tag="all" />
                    <ComboBoxItem Content="This session" Tag="session" />
                    <ComboBoxItem Content="Last hour" Tag="hour" />
                    <ComboBoxItem Content="Today" Tag="today" />
                    <ComboBoxItem Content="Last 7 days" Tag="week" />
                </ComboBox>
            </Grid>
        </Border>

        <Grid
            x:Name="ActivityCommandGrid"
            Grid.Row="2"
            Margin="0,0,0,12"
            ColumnSpacing="8"
            RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button
                x:Name="CopyEventButton"
                AutomationProperties.Name="Copy the selected event"
                Click="OnCopyEventClick"
                Content="Copy selected"
                IsEnabled="False" />
            <Button
                x:Name="OpenLogLocationButton"
                Grid.Column="1"
                AutomationProperties.Name="Open the log location"
                Click="OnOpenLogLocationClick"
                Content="Open log location"
                IsEnabled="False" />
            <TextBlock
                x:Name="ActivityCount"
                Grid.Column="3"
                VerticalAlignment="Center"
                AutomationProperties.LiveSetting="Polite"
                Style="{StaticResource DesktopShift.CaptionStyle}" />
        </Grid>

        <Grid Grid.Row="3">
            <ListView
                x:Name="ActivityList"
                AutomationProperties.Name="Recent activity"
                ItemContainerStyle="{StaticResource DesktopShift.CardListItemStyle}"
                SelectionChanged="OnSelectionChanged"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="diagnostics:ActivityRecordDisplay">
                        <Border
                            AutomationProperties.Name="{Binding AutomationName}"
                            Style="{StaticResource DesktopShift.ListCardStyle}">
                            <Grid ColumnSpacing="13" SizeChanged="OnActivityCardSizeChanged">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border
                                    Grid.RowSpan="2"
                                    Width="34"
                                    Height="34"
                                    Style="{StaticResource DesktopShift.IconTileStyle}">
                                    <FontIcon Style="{StaticResource DesktopShift.IconTileGlyphStyle}" Glyph="&#xE9D9;" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Style="{StaticResource DesktopShift.RowTitleStyle}" Text="{Binding Summary}" />
                                    <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}">
                                        <Run Text="{Binding Application}" />
                                        <Run Text="  •  " />
                                        <Run Text="{Binding Target}" />
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Foreground="{ThemeResource DesktopShift.AccentStrongBrush}" Style="{StaticResource DesktopShift.CaptionStyle}" Text="{Binding ResultLabel}" />
                                        <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="{Binding Source}" />
                                        <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="{Binding Duration}" />
                                        <Button
                                            Padding="8,2"
                                            AutomationProperties.Name="Create a rule for this application"
                                            Click="OnCreateRuleClick"
                                            Content="Create rule"
                                            Tag="{x:Bind}"
                                            Visibility="{x:Bind rules:RuleIconSource.WhenTrue(OffersRuleCreation)}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock
                                    x:Name="ActivityTimestamp"
                                    Grid.Column="2"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource DesktopShift.CaptionStyle}"
                                    Text="{Binding Timestamp}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border
                x:Name="EmptyState"
                MinHeight="300"
                AutomationProperties.Name="No activity to show"
                Style="{StaticResource DesktopShift.CardStyle}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                    <FontIcon HorizontalAlignment="Center" Style="{StaticResource DesktopShift.EmptyStateIconStyle}" Glyph="&#xE9D9;" />
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource DesktopShift.SectionHeadingStyle}" Text="Nothing to report" />
                    <TextBlock
                        x:Name="EmptyStateMessage"
                        MaxWidth="500"
                        Style="{StaticResource DesktopShift.PageSubtitleStyle}"
                        Text="Decisions, moves, switches, and assignment results will appear here with privacy-safe app identity."
                        TextAlignment="Center" />
                </StackPanel>
            </Border>
            <InfoBar
                x:Name="StatusBar"
                Margin="0,0,0,12"
                VerticalAlignment="Bottom"
                AutomationProperties.LiveSetting="Polite"
                IsClosable="True"
                IsOpen="False" />
        </Grid>
    </Grid>
</Page>
