<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DesktopShift.App.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.Name="Overview page"
    Background="Transparent">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="{StaticResource DesktopShift.PageContentMaxWidth}"
            Margin="{StaticResource DesktopShift.PageMargin}"
            HorizontalAlignment="Left"
            Spacing="{StaticResource DesktopShift.SectionSpacing}">
            <StackPanel Spacing="{StaticResource DesktopShift.TightSpacing}">
                <TextBlock Style="{StaticResource DesktopShift.PageTitleStyle}" Text="Overview" />
                <TextBlock Style="{StaticResource DesktopShift.PageSubtitleStyle}" Text="A calm home for your automatic desktop assignments." />
            </StackPanel>

            <Border Style="{StaticResource DesktopShift.CardStyle}">
                <Grid ColumnSpacing="{StaticResource DesktopShift.SectionSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="{StaticResource DesktopShift.ItemSpacing}">
                        <TextBlock Style="{StaticResource DesktopShift.SectionHeadingStyle}" Text="Your workspace, automatically organized" />
                        <TextBlock
                            x:Name="WorkspaceSummary"
                            MaxWidth="600"
                            Style="{StaticResource DesktopShift.PageSubtitleStyle}" />
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        AutomationProperties.Name="Compatibility mode"
                        Style="{StaticResource DesktopShift.PillStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource DesktopShift.ItemSpacing}">
                            <Ellipse
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource DesktopShift.WarningBrush}" />
                            <TextBlock x:Name="ModeStatus" Style="{StaticResource DesktopShift.PillTextStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid ColumnSpacing="{StaticResource DesktopShift.CardSpacing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource DesktopShift.CardStyle}">
                    <Grid ColumnSpacing="{StaticResource DesktopShift.CardSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="EnabledRuleCount"
                            AutomationProperties.Name="Enabled application rule count"
                            Style="{StaticResource DesktopShift.MetricStyle}" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="{StaticResource DesktopShift.TightSpacing}">
                            <TextBlock Style="{StaticResource DesktopShift.SectionHeadingStyle}" Text="Enabled rules" />
                            <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="Persisted application mappings" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource DesktopShift.CardStyle}">
                    <Grid ColumnSpacing="{StaticResource DesktopShift.CardSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="ManagedDesktopCount"
                            AutomationProperties.Name="Managed desktop count"
                            Style="{StaticResource DesktopShift.MetricStyle}" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="{StaticResource DesktopShift.TightSpacing}">
                            <TextBlock Style="{StaticResource DesktopShift.SectionHeadingStyle}" Text="Managed desktops" />
                            <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="Semantic workspace destinations" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border
                x:Name="ManagedMappingCard"
                AutomationProperties.LiveSetting="Polite"
                Style="{StaticResource DesktopShift.CardStyle}"
                Visibility="Collapsed">
                <StackPanel Spacing="{StaticResource DesktopShift.GroupSpacing}">
                    <Grid ColumnSpacing="{StaticResource DesktopShift.GroupSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource DesktopShift.IconTileStyle}">
                            <FontIcon Style="{StaticResource DesktopShift.IconTileGlyphStyle}" Glyph="&#xE7F4;" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="{StaticResource DesktopShift.TightSpacing}">
                            <TextBlock
                                Style="{StaticResource DesktopShift.SectionHeadingStyle}"
                                Text="Managed desktop mapping" />
                            <TextBlock
                                x:Name="ManagedMappingSummary"
                                Style="{StaticResource DesktopShift.PageSubtitleStyle}" />
                        </StackPanel>
                        <TextBlock
                            x:Name="ManagedMappingOutcome"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource DesktopShift.AccentStrongBrush}"
                            Style="{StaticResource DesktopShift.SectionTitleStyle}" />
                    </Grid>
                    <Grid ColumnSpacing="{StaticResource DesktopShift.CardSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource DesktopShift.BadgeStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource DesktopShift.ItemSpacing}">
                                <TextBlock
                                    x:Name="MappedDesktopCount"
                                    AutomationProperties.Name="Mapped managed desktop count"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource DesktopShift.AccentStrongBrush}"
                                    Style="{StaticResource DesktopShift.BodyStyle}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource DesktopShift.CaptionStyle}"
                                    Text="mapped" />
                            </StackPanel>
                        </Border>
                        <Border
                            Grid.Column="1"
                            Background="{ThemeResource DesktopShift.SurfaceSecondaryBrush}"
                            Style="{StaticResource DesktopShift.BadgeStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource DesktopShift.ItemSpacing}">
                                <TextBlock
                                    x:Name="MappingAttentionCount"
                                    AutomationProperties.Name="Managed desktop mappings needing attention"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource DesktopShift.BodyStyle}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource DesktopShift.CaptionStyle}"
                                    Text="need attention" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock
                        x:Name="ManagedMappingProvider"
                        Style="{StaticResource DesktopShift.CaptionStyle}" />
                </StackPanel>
            </Border>

            <Border
                x:Name="AssignmentCard"
                AutomationProperties.LiveSetting="Polite"
                Style="{StaticResource DesktopShift.CardStyle}">
                <StackPanel Spacing="{StaticResource DesktopShift.GroupSpacing}">
                    <Grid ColumnSpacing="{StaticResource DesktopShift.GroupSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource DesktopShift.IconTileStyle}">
                            <FontIcon Style="{StaticResource DesktopShift.IconTileGlyphStyle}" Glyph="&#xE8FB;" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="{StaticResource DesktopShift.TightSpacing}">
                            <TextBlock
                                Style="{StaticResource DesktopShift.SectionHeadingStyle}"
                                Text="Last assignment" />
                            <TextBlock
                                x:Name="LastAssignmentSummary"
                                Style="{StaticResource DesktopShift.PageSubtitleStyle}"
                                Text="No assignment has completed yet." />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="{StaticResource DesktopShift.GroupSpacing}">
                            <ProgressRing
                                x:Name="ReassignmentProgress"
                                Width="20"
                                Height="20"
                                AutomationProperties.Name="Reassigning windows"
                                IsActive="False"
                                Visibility="Collapsed" />
                            <Button
                                x:Name="ReassignNowButton"
                                AutomationProperties.HelpText="Enumerates open windows once and awaits the completed reassignment batch."
                                AutomationProperties.Name="Reassign windows now"
                                Click="OnReassignNowClick"
                                Content="Reassign now"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid
                        x:Name="LastAssignmentDetails"
                        ColumnSpacing="24"
                        RowSpacing="{StaticResource DesktopShift.ItemSpacing}"
                        Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="{StaticResource DesktopShift.TightSpacing}">
                            <TextBlock
                                x:Name="OutcomeLabel"
                                Style="{StaticResource DesktopShift.FieldLabelStyle}"
                                Text="Outcome" />
                            <TextBlock
                                x:Name="LastAssignmentOutcome"
                                AutomationProperties.LabeledBy="{x:Bind OutcomeLabel}"
                                Style="{StaticResource DesktopShift.BodyStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="{StaticResource DesktopShift.TightSpacing}">
                            <TextBlock
                                x:Name="CompletedLabel"
                                Style="{StaticResource DesktopShift.FieldLabelStyle}"
                                Text="Completed" />
                            <TextBlock
                                x:Name="LastAssignmentTime"
                                AutomationProperties.LabeledBy="{x:Bind CompletedLabel}"
                                Style="{StaticResource DesktopShift.BodyStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="{StaticResource DesktopShift.TightSpacing}">
                            <TextBlock
                                x:Name="ProcessLabel"
                                Style="{StaticResource DesktopShift.FieldLabelStyle}"
                                Text="Process" />
                            <TextBlock
                                x:Name="LastAssignmentProcess"
                                AutomationProperties.LabeledBy="{x:Bind ProcessLabel}"
                                Style="{StaticResource DesktopShift.BodyStyle}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="1"
                            Spacing="{StaticResource DesktopShift.TightSpacing}">
                            <TextBlock
                                x:Name="TargetDesktopLabel"
                                Style="{StaticResource DesktopShift.FieldLabelStyle}"
                                Text="Target desktop" />
                            <TextBlock
                                x:Name="LastAssignmentTarget"
                                AutomationProperties.LabeledBy="{x:Bind TargetDesktopLabel}"
                                Style="{StaticResource DesktopShift.BodyStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Spacing="{StaticResource DesktopShift.TightSpacing}">
                            <TextBlock
                                x:Name="DurationLabel"
                                Style="{StaticResource DesktopShift.FieldLabelStyle}"
                                Text="Duration" />
                            <TextBlock
                                x:Name="LastAssignmentDuration"
                                AutomationProperties.LabeledBy="{x:Bind DurationLabel}"
                                Style="{StaticResource DesktopShift.BodyStyle}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="2"
                            Grid.Column="1"
                            Spacing="{StaticResource DesktopShift.TightSpacing}">
                            <TextBlock
                                x:Name="CorrelationLabel"
                                Style="{StaticResource DesktopShift.FieldLabelStyle}"
                                Text="Correlation ID" />
                            <TextBlock
                                x:Name="LastAssignmentCorrelation"
                                AutomationProperties.LabeledBy="{x:Bind CorrelationLabel}"
                                Style="{StaticResource DesktopShift.MonospaceStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Spacing="{StaticResource DesktopShift.TightSpacing}">
                            <TextBlock
                                x:Name="MovementLabel"
                                Style="{StaticResource DesktopShift.FieldLabelStyle}"
                                Text="Window movement" />
                            <TextBlock
                                x:Name="LastAssignmentMovement"
                                AutomationProperties.LabeledBy="{x:Bind MovementLabel}"
                                Style="{StaticResource DesktopShift.BodyStyle}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="3"
                            Grid.Column="1"
                            Spacing="{StaticResource DesktopShift.TightSpacing}">
                            <TextBlock
                                x:Name="NavigationLabel"
                                Style="{StaticResource DesktopShift.FieldLabelStyle}"
                                Text="Desktop navigation" />
                            <TextBlock
                                x:Name="LastAssignmentNavigation"
                                AutomationProperties.LabeledBy="{x:Bind NavigationLabel}"
                                Style="{StaticResource DesktopShift.BodyStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="4" Spacing="{StaticResource DesktopShift.TightSpacing}">
                            <TextBlock
                                x:Name="SwitchPolicyLabel"
                                Style="{StaticResource DesktopShift.FieldLabelStyle}"
                                Text="Switch policy" />
                            <TextBlock
                                x:Name="LastAssignmentSwitchPolicy"
                                AutomationProperties.LabeledBy="{x:Bind SwitchPolicyLabel}"
                                Style="{StaticResource DesktopShift.BodyStyle}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="4"
                            Grid.Column="1"
                            Spacing="{StaticResource DesktopShift.TightSpacing}">
                            <TextBlock
                                x:Name="SwitchDurationLabel"
                                Style="{StaticResource DesktopShift.FieldLabelStyle}"
                                Text="Switch duration" />
                            <TextBlock
                                x:Name="LastAssignmentSwitchDuration"
                                AutomationProperties.LabeledBy="{x:Bind SwitchDurationLabel}"
                                Style="{StaticResource DesktopShift.BodyStyle}" />
                        </StackPanel>
                        <StackPanel
                            x:Name="LastAssignmentRelatedCorrelationPanel"
                            Grid.Row="5"
                            Grid.ColumnSpan="2"
                            Spacing="{StaticResource DesktopShift.TightSpacing}"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="RelatedCorrelationLabel"
                                Style="{StaticResource DesktopShift.FieldLabelStyle}"
                                Text="Related correlation ID" />
                            <TextBlock
                                x:Name="LastAssignmentRelatedCorrelation"
                                AutomationProperties.LabeledBy="{x:Bind RelatedCorrelationLabel}"
                                Style="{StaticResource DesktopShift.MonospaceStyle}" />
                        </StackPanel>
                    </Grid>

                    <InfoBar
                        x:Name="ReassignmentResult"
                        AutomationProperties.Name="Manual reassignment result"
                        IsClosable="True"
                        IsOpen="False" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DesktopShift.CardStyle}">
                <StackPanel Spacing="{StaticResource DesktopShift.GroupSpacing}">
                    <Grid ColumnSpacing="{StaticResource DesktopShift.GroupSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            VerticalAlignment="Top"
                            AutomationProperties.AccessibilityView="Raw"
                            FontSize="20"
                            Foreground="{ThemeResource DesktopShift.WarningBrush}"
                            Glyph="&#xE7BA;" />
                        <StackPanel Grid.Column="1" Spacing="{StaticResource DesktopShift.TightSpacing}">
                            <TextBlock x:Name="ProviderName" Style="{StaticResource DesktopShift.SectionHeadingStyle}" />
                            <TextBlock x:Name="BuildInfo" Style="{StaticResource DesktopShift.CaptionStyle}" />
                        </StackPanel>
                        <TextBlock
                            x:Name="TestOutcome"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource DesktopShift.CaptionStyle}" />
                    </Grid>
                    <TextBlock x:Name="CompatibilityExplanation" Style="{StaticResource DesktopShift.PageSubtitleStyle}" />
                    <TextBlock x:Name="CapabilitySummary" Style="{StaticResource DesktopShift.CaptionStyle}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
