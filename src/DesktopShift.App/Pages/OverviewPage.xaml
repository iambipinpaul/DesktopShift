<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DesktopShift.App.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.Name="Home page"
    Background="Transparent"
    SizeChanged="OnPageSizeChanged">
    <Page.Resources>
        <Style x:Key="HomeRowButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="68" />
            <Setter Property="Padding" Value="15,10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style x:Key="HomeRowTitleStyle" BasedOn="{StaticResource DesktopShift.BodyStyle}" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Page.Resources>
    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            x:Name="HomeContent"
            MaxWidth="{StaticResource DesktopShift.PageContentMaxWidth}"
            Margin="{StaticResource DesktopShift.PageMargin}"
            HorizontalAlignment="Center">
            <StackPanel
                Margin="0,0,0,12"
                Orientation="Horizontal"
                Spacing="7">
                <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="DesktopShift" />
                <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="›" />
                <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="Home" />
            </StackPanel>

            <Grid Margin="0,0,0,22" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource DesktopShift.PageTitleStyle}" Text="Home" />
                    <TextBlock
                        Style="{StaticResource DesktopShift.PageSubtitleStyle}"
                        Text="Review workspace health and manage the most important DesktopShift behavior." />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Spacing="{StaticResource DesktopShift.GroupSpacing}">
                    <ProgressRing
                        x:Name="ReassignmentProgress"
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Reassigning windows"
                        IsActive="False"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="ReassignNowButton"
                        AutomationProperties.HelpText="Enumerates open windows once and awaits the completed reassignment batch."
                        AutomationProperties.Name="Reassign windows now"
                        Click="OnReassignNowClick"
                        Padding="12,7"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="12" Glyph="&#xE895;" />
                            <TextBlock Text="Reassign now" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border
                MinHeight="83"
                Margin="0,0,0,14"
                Padding="18"
                Style="{StaticResource DesktopShift.CardStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="44"
                        Height="44"
                        Background="{ThemeResource DesktopShift.AccentSoftBrush}"
                        CornerRadius="8">
                        <FontIcon
                            FontSize="18"
                            Foreground="{ThemeResource DesktopShift.AccentStrongBrush}"
                            Glyph="&#xE7F4;" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock
                            x:Name="WorkspaceStatusTitle"
                            Style="{StaticResource DesktopShift.SectionHeadingStyle}"
                            Text="Your workspace is organized" />
                        <TextBlock
                            x:Name="WorkspaceSummary"
                            MaxWidth="600"
                            Style="{StaticResource DesktopShift.CaptionStyle}" />
                    </StackPanel>
                    <Border
                        Grid.Column="2"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="Compatibility mode"
                        Style="{StaticResource DesktopShift.PillStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource DesktopShift.ItemSpacing}">
                            <Ellipse
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource DesktopShift.SuccessBrush}" />
                            <TextBlock x:Name="ModeStatus" Style="{StaticResource DesktopShift.PillTextStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,24" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border MinHeight="83" Padding="12" Style="{StaticResource DesktopShift.CardStyle}">
                    <StackPanel VerticalAlignment="Center" Spacing="3">
                        <TextBlock FontSize="10" Style="{StaticResource DesktopShift.CaptionStyle}" Text="ENABLED RULES" />
                        <TextBlock
                            x:Name="EnabledRuleCount"
                            AutomationProperties.Name="Enabled application rule count"
                            Style="{StaticResource DesktopShift.MetricStyle}" />
                        <TextBlock FontSize="10" Style="{StaticResource DesktopShift.CaptionStyle}" Text="persisted mappings" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" MinHeight="83" Padding="12" Style="{StaticResource DesktopShift.CardStyle}">
                    <StackPanel VerticalAlignment="Center" Spacing="3">
                        <TextBlock FontSize="10" Style="{StaticResource DesktopShift.CaptionStyle}" Text="MANAGED DESKTOPS" />
                        <TextBlock
                            x:Name="ManagedDesktopCount"
                            AutomationProperties.Name="Managed desktop count"
                            Style="{StaticResource DesktopShift.MetricStyle}" />
                        <TextBlock FontSize="10" Style="{StaticResource DesktopShift.CaptionStyle}" Text="all mapped" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" MinHeight="83" Padding="12" Style="{StaticResource DesktopShift.CardStyle}">
                    <StackPanel VerticalAlignment="Center" Spacing="3">
                        <TextBlock FontSize="10" Style="{StaticResource DesktopShift.CaptionStyle}" Text="LAST ASSIGNMENT" />
                        <TextBlock
                            x:Name="LastAssignmentMetric"
                            AutomationProperties.Name="Last assignment duration"
                            Style="{StaticResource DesktopShift.MetricStyle}"
                            Text="—" />
                        <TextBlock
                            x:Name="LastAssignmentMetricCaption"
                            FontSize="10"
                            Style="{StaticResource DesktopShift.CaptionStyle}"
                            Text="No completed assignment" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Margin="0,0,0,24" Spacing="10">
                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    Style="{StaticResource DesktopShift.BodyStyle}"
                    Text="Workspace" />
                <Border Padding="0" Style="{StaticResource DesktopShift.CardStyle}">
                    <StackPanel>
                        <Button
                            AutomationProperties.Name="Open application rules"
                            Click="OnNavigateClick"
                            Style="{StaticResource HomeRowButtonStyle}"
                            Tag="rules">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon VerticalAlignment="Center" Glyph="&#xE8EF;" />
                                <StackPanel Grid.Column="1" Spacing="{StaticResource DesktopShift.TightSpacing}">
                                    <TextBlock Style="{StaticResource HomeRowTitleStyle}" Text="Application rules" />
                                    <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="Choose which desktop each application belongs to." />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                                    <TextBlock x:Name="WorkspaceRuleCount" Style="{StaticResource DesktopShift.CaptionStyle}" />
                                    <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xE76C;" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Border Style="{StaticResource DesktopShift.SeparatorStyle}" />
                        <Button
                            AutomationProperties.Name="Open managed desktops"
                            Click="OnNavigateClick"
                            Style="{StaticResource HomeRowButtonStyle}"
                            Tag="desktops">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon VerticalAlignment="Center" Glyph="&#xE7F4;" />
                                <StackPanel Grid.Column="1" Spacing="{StaticResource DesktopShift.TightSpacing}">
                                    <TextBlock Style="{StaticResource HomeRowTitleStyle}" Text="Managed desktops" />
                                    <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="Review semantic destinations and their live Windows mappings." />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                                    <TextBlock x:Name="WorkspaceDesktopCount" Style="{StaticResource DesktopShift.CaptionStyle}" />
                                    <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xE76C;" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Border Style="{StaticResource DesktopShift.SeparatorStyle}" />
                        <Button
                            AutomationProperties.Name="Open recent activity"
                            Click="OnNavigateClick"
                            Style="{StaticResource HomeRowButtonStyle}"
                            Tag="activity">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon VerticalAlignment="Center" Glyph="&#xE9D9;" />
                                <StackPanel Grid.Column="1" Spacing="{StaticResource DesktopShift.TightSpacing}">
                                    <TextBlock Style="{StaticResource HomeRowTitleStyle}" Text="Recent activity" />
                                    <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="See movements, skips, failures, and timing details." />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                                    <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="Current session" />
                                    <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xE76C;" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Margin="0,0,0,24" Spacing="10">
                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    Style="{StaticResource DesktopShift.BodyStyle}"
                    Text="Quick settings" />
                <Border Padding="0" Style="{StaticResource DesktopShift.CardStyle}">
                    <StackPanel>
                        <Grid
                            MinHeight="68"
                            Padding="15,10"
                            ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xE73E;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource DesktopShift.TightSpacing}">
                                <TextBlock Style="{StaticResource HomeRowTitleStyle}" Text="Automatic assignment" />
                                <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="Apply enabled rules when windows are created, shown, or activated." />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="AutomaticAssignmentToggle"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Automatic assignment"
                                Toggled="OnAutomaticAssignmentToggled" />
                        </Grid>
                        <Border Style="{StaticResource DesktopShift.SeparatorStyle}" />
                        <Grid
                            MinHeight="68"
                            Padding="15,10"
                            ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xE72C;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource DesktopShift.TightSpacing}">
                                <TextBlock Style="{StaticResource HomeRowTitleStyle}" Text="Recreate missing managed desktops" />
                                <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="Restore semantic destinations after a desktop is deleted." />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="RecreateMissingToggle"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Recreate missing managed desktops"
                                Toggled="OnRecreateMissingToggled" />
                        </Grid>
                        <Border Style="{StaticResource DesktopShift.SeparatorStyle}" />
                        <Button
                            AutomationProperties.Name="Open appearance settings"
                            Click="OnNavigateClick"
                            Style="{StaticResource HomeRowButtonStyle}"
                            Tag="settings">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon VerticalAlignment="Center" Glyph="&#xE790;" />
                                <StackPanel Grid.Column="1" Spacing="{StaticResource DesktopShift.TightSpacing}">
                                    <TextBlock Style="{StaticResource HomeRowTitleStyle}" Text="Appearance" />
                                    <TextBlock
                                        x:Name="AppearanceSummary"
                                        Style="{StaticResource DesktopShift.CaptionStyle}"
                                        Text="Use Windows theme and accent color." />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                                    <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="Windows setting" />
                                    <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xE76C;" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>

            <InfoBar
                x:Name="ReassignmentResult"
                AutomationProperties.Name="Manual reassignment result"
                IsClosable="True"
                IsOpen="False" />

        </StackPanel>
    </ScrollViewer>
</Page>
