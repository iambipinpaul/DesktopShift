<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DesktopShift.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.Name="Settings page"
    Background="Transparent">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="960" Margin="32,28" HorizontalAlignment="Left" Spacing="20">
            <StackPanel Spacing="5">
                <TextBlock Style="{StaticResource DesktopShift.PageTitleStyle}" Text="Settings" />
                <TextBlock Style="{StaticResource DesktopShift.PageSubtitleStyle}" Text="Review appearance and the exact capabilities available on this Windows build." />
            </StackPanel>

            <Border Style="{StaticResource DesktopShift.CardStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="5">
                        <TextBlock Style="{StaticResource DesktopShift.SectionTitleStyle}" Text="Appearance" />
                        <TextBlock
                            MaxWidth="560"
                            Style="{StaticResource DesktopShift.PageSubtitleStyle}"
                            Text="Choose System, Light, or Dark from the appearance control at the bottom of the navigation pane. The preference is saved for the next launch." />
                    </StackPanel>
                    <FontIcon
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource DesktopShift.EmptyStateIconStyle}"
                        Glyph="&#xE790;" />
                </Grid>
            </Border>

            <Border Style="{StaticResource DesktopShift.CardStyle}">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource DesktopShift.SectionTitleStyle}" Text="Windows compatibility" />
                            <TextBlock
                                Style="{StaticResource DesktopShift.PageSubtitleStyle}"
                                Text="DesktopShift reports only capabilities proven available through its selected provider." />
                        </StackPanel>
                        <Border
                            Grid.Column="1"
                            Padding="11,5"
                            VerticalAlignment="Top"
                            Background="{ThemeResource DesktopShift.AccentSoftBrush}"
                            CornerRadius="999">
                            <TextBlock
                                x:Name="ModeValue"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource DesktopShift.TextPrimaryBrush}" />
                        </Border>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource DesktopShift.BorderBrush}" />

                    <Grid RowSpacing="10" ColumnSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="Windows build" />
                        <TextBlock x:Name="BuildValue" Grid.Column="1" Style="{StaticResource DesktopShift.BodyStyle}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource DesktopShift.CaptionStyle}" Text="Build support" />
                        <TextBlock x:Name="BuildSupportValue" Grid.Row="1" Grid.Column="1" Style="{StaticResource DesktopShift.BodyStyle}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource DesktopShift.CaptionStyle}" Text="Topology provider" />
                        <TextBlock x:Name="ProviderValue" Grid.Row="2" Grid.Column="1" Style="{StaticResource DesktopShift.BodyStyle}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource DesktopShift.CaptionStyle}" Text="Capabilities" />
                        <TextBlock x:Name="CapabilitiesValue" Grid.Row="3" Grid.Column="1" Style="{StaticResource DesktopShift.BodyStyle}" />
                    </Grid>

                    <InfoBar
                        x:Name="LimitedModeExplanation"
                        IsClosable="False"
                        IsIconVisible="True"
                        IsOpen="True"
                        Severity="Warning"
                        Title="Why capabilities are limited" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="TestOutcomeValue" Style="{StaticResource DesktopShift.BodyStyle}" />
                            <TextBlock x:Name="TestSummaryValue" Style="{StaticResource DesktopShift.CaptionStyle}" />
                            <TextBlock x:Name="TestedAtValue" Style="{StaticResource DesktopShift.CaptionStyle}" />
                        </StackPanel>
                        <Button
                            x:Name="RunCompatibilityTestButton"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.HelpText="Checks the currently selected provider and refreshes its reported result."
                            Click="OnRunCompatibilityTestClick"
                            Content="Run compatibility test" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
