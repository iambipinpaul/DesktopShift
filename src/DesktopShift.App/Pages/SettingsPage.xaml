<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DesktopShift.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:DesktopShift.App.Settings"
    AutomationProperties.Name="System settings page"
    Background="Transparent"
    SizeChanged="OnPageSizeChanged">
    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            x:Name="SettingsContent"
            MaxWidth="{StaticResource DesktopShift.PageContentMaxWidth}"
            Margin="{StaticResource DesktopShift.PageMargin}"
            HorizontalAlignment="Center">
            <StackPanel Margin="0,0,0,12" Orientation="Horizontal" Spacing="7">
                <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="DesktopShift" />
                <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="›" />
                <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="System settings" />
            </StackPanel>
            <StackPanel Margin="0,0,0,22" Spacing="4">
                <TextBlock Style="{StaticResource DesktopShift.PageTitleStyle}" Text="System settings" />
                <TextBlock
                    Style="{StaticResource DesktopShift.PageSubtitleStyle}"
                    Text="Configure startup, assignment, window tiling, compatibility, and appearance." />
            </StackPanel>

            <InfoBar
                x:Name="SettingsStatus"
                Margin="0,0,0,14"
                AutomationProperties.LiveSetting="Polite"
                IsClosable="True"
                IsOpen="False" />

            <TextBlock
                x:Name="AppearanceSectionTitle"
                Style="{StaticResource DesktopShift.SectionLabelStyle}"
                Text="Appearance" />
            <Border Style="{StaticResource DesktopShift.GroupCardStyle}">
                <StackPanel>
                    <Border Style="{StaticResource DesktopShift.SettingRowStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Foreground="{ThemeResource DesktopShift.TextSecondaryBrush}" Glyph="&#xE790;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource DesktopShift.RowTitleStyle}" Text="App theme" />
                                <TextBlock Style="{StaticResource DesktopShift.RowDescriptionStyle}" Text="Follow Windows by default, or choose a fixed light or dark theme." />
                            </StackPanel>
                            <ComboBox
                                x:Name="ThemePicker"
                                Grid.Column="2"
                                MinWidth="190"
                                AutomationProperties.Name="App theme"
                                SelectionChanged="OnThemeSelectionChanged">
                                <ComboBoxItem Content="Use Windows setting" Tag="System" />
                                <ComboBoxItem Content="Light" Tag="Light" />
                                <ComboBoxItem Content="Dark" Tag="Dark" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border BorderThickness="0,1,0,0" Style="{StaticResource DesktopShift.SettingRowStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Foreground="{ThemeResource DesktopShift.TextSecondaryBrush}" Glyph="&#xE2B1;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource DesktopShift.RowTitleStyle}" Text="App color" />
                                <TextBlock Style="{StaticResource DesktopShift.RowDescriptionStyle}" Text="Use the Windows accent color, or the optional Aditi Kraft Blue." />
                            </StackPanel>
                            <ComboBox
                                x:Name="AccentPicker"
                                Grid.Column="2"
                                MinWidth="190"
                                AutomationProperties.HelpText="Windows High Contrast always takes priority over this setting."
                                AutomationProperties.Name="App color"
                                SelectionChanged="OnAccentSelectionChanged">
                                <ComboBoxItem Content="Use Windows accent color" Tag="System" />
                                <ComboBoxItem Content="Aditi Kraft Blue" Tag="AditiKraftBlue" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border BorderThickness="0,1,0,0" Style="{StaticResource DesktopShift.SettingRowStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Foreground="{ThemeResource DesktopShift.TextSecondaryBrush}" Glyph="&#xE946;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource DesktopShift.RowTitleStyle}" Text="High contrast" />
                                <TextBlock Style="{StaticResource DesktopShift.RowDescriptionStyle}" Text="Windows system colors override app styling automatically when High Contrast is active." />
                            </StackPanel>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource DesktopShift.CaptionStyle}" Text="Managed by Windows" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Margin="0,14,0,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Padding="14" Background="{ThemeResource DesktopShift.SurfaceSecondaryBrush}" BorderBrush="{ThemeResource DesktopShift.BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="Accent preview" />
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Width="36" Height="28" Background="{ThemeResource DesktopShift.AccentBrush}" CornerRadius="5" />
                            <Button Content="Primary action" Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="14" Background="{ThemeResource DesktopShift.SurfaceSecondaryBrush}" BorderBrush="{ThemeResource DesktopShift.BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="Selection preview" />
                        <Border Height="28" Background="{ThemeResource DesktopShift.AccentSoftBrush}" CornerRadius="5">
                            <Border Width="3" HorizontalAlignment="Left" Background="{ThemeResource DesktopShift.AccentBrush}" CornerRadius="3" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock
                x:Name="StartupSectionTitle"
                Margin="0,24,0,10"
                Style="{StaticResource DesktopShift.SectionLabelStyle}"
                Text="Startup" />
            <Border Style="{StaticResource DesktopShift.GroupCardStyle}">
                <StackPanel>
                    <Border Style="{StaticResource DesktopShift.SettingRowStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xE80F;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource DesktopShift.RowTitleStyle}" Text="Start with Windows" />
                                <TextBlock Style="{StaticResource DesktopShift.RowDescriptionStyle}" Text="Launch DesktopShift for the current Windows user." />
                                <TextBlock x:Name="StartupStateValue" Style="{StaticResource DesktopShift.CaptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="StartWithWindowsToggle" Grid.Column="2" AutomationProperties.Name="Start with Windows" OffContent="" OnContent="" Toggled="OnPersistedBehaviorChanged" />
                        </Grid>
                    </Border>
                    <Border BorderThickness="0,1,0,0" Style="{StaticResource DesktopShift.SettingRowStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xE7F4;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource DesktopShift.RowTitleStyle}" Text="Start minimized" />
                                <TextBlock Style="{StaticResource DesktopShift.RowDescriptionStyle}" Text="Keep DesktopShift in the notification area after sign-in." />
                            </StackPanel>
                            <ToggleSwitch x:Name="StartMinimizedToggle" Grid.Column="2" AutomationProperties.Name="Start minimized to the notification area" OffContent="" OnContent="" Toggled="OnPersistedBehaviorChanged" />
                        </Grid>
                    </Border>
                    <Border BorderThickness="0,1,0,0" Style="{StaticResource DesktopShift.SettingRowStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xE8BB;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource DesktopShift.RowTitleStyle}" Text="Close to notification area" />
                                <TextBlock Style="{StaticResource DesktopShift.RowDescriptionStyle}" Text="Closing the window keeps automatic assignment running." />
                            </StackPanel>
                            <ToggleSwitch x:Name="CloseToTrayToggle" Grid.Column="2" AutomationProperties.Name="Close to the notification area" OffContent="" OnContent="" Toggled="OnPersistedBehaviorChanged" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock
                x:Name="AssignmentSectionTitle"
                Margin="0,24,0,10"
                Style="{StaticResource DesktopShift.SectionLabelStyle}"
                Text="Assignment behavior" />
            <Border Style="{StaticResource DesktopShift.GroupCardStyle}">
                <StackPanel>
                    <Border Style="{StaticResource DesktopShift.SettingRowStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xE768;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource DesktopShift.RowTitleStyle}" Text="Start automatic assignment paused" />
                                <TextBlock Style="{StaticResource DesktopShift.RowDescriptionStyle}" Text="Begin each launch without processing automatic window events." />
                            </StackPanel>
                            <ToggleSwitch x:Name="StartAssignmentPausedToggle" Grid.Column="2" AutomationProperties.Name="Start automatic assignment paused" OffContent="" OnContent="" Toggled="OnPersistedBehaviorChanged" />
                        </Grid>
                    </Border>
                    <Border BorderThickness="0,1,0,0" Style="{StaticResource DesktopShift.SettingRowStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xE769;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource DesktopShift.RowTitleStyle}" Text="Pause automatic assignment now" />
                                <TextBlock Style="{StaticResource DesktopShift.RowDescriptionStyle}" Text="Pause foreground and window lifecycle assignment until resumed." />
                            </StackPanel>
                            <ToggleSwitch x:Name="AssignmentPausedToggle" Grid.Column="2" AutomationProperties.Name="Automatic assignment paused now" OffContent="" OnContent="" Toggled="OnLivePauseToggled" />
                        </Grid>
                    </Border>
                    <Border BorderThickness="0,1,0,0" Style="{StaticResource DesktopShift.SettingRowStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xE72C;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource DesktopShift.RowTitleStyle}" Text="Reassign all windows" />
                                <TextBlock Style="{StaticResource DesktopShift.RowDescriptionStyle}" Text="Apply all enabled rules to the windows that are open now." />
                            </StackPanel>
                            <Button x:Name="ReassignAllButton" Grid.Column="2" AutomationProperties.Name="Reassign all windows now" Click="OnReassignAllClick" Content="Reassign now" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock
                x:Name="TilingSectionTitle"
                Margin="0,24,0,10"
                Style="{StaticResource DesktopShift.SectionLabelStyle}"
                Text="Window tiling" />
            <Border Style="{StaticResource DesktopShift.GroupCardStyle}">
                <StackPanel>
                    <Border Style="{StaticResource DesktopShift.SettingRowStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xE8A9;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource DesktopShift.RowTitleStyle}" Text="Enable native BSP tiling" />
                                <TextBlock Style="{StaticResource DesktopShift.RowDescriptionStyle}" Text="Arrange normal windows independently on each virtual desktop and monitor." />
                            </StackPanel>
                            <ToggleSwitch x:Name="TilingEnabledToggle" Grid.Column="2" AutomationProperties.Name="Enable native BSP window tiling" OffContent="" OnContent="" Toggled="OnTilingEnabledToggled" />
                        </Grid>
                    </Border>
                    <Border Padding="15,12" BorderBrush="{ThemeResource DesktopShift.BorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource DesktopShift.RowDescriptionStyle}" Text="Layout: BSP. New windows split the focused tile when possible, or the largest tile otherwise." TextWrapping="Wrap" />
                            <Grid ColumnSpacing="16" RowSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <NumberBox x:Name="TilingOuterGapNumber" Grid.Row="0" Grid.Column="0" AutomationProperties.Name="Outer gap" Header="Outer gap" Maximum="256" Minimum="0" SmallChange="1" SpinButtonPlacementMode="Inline" />
                                <NumberBox x:Name="TilingInnerGapNumber" Grid.Row="0" Grid.Column="1" AutomationProperties.Name="Inner gap" Header="Inner gap" Maximum="256" Minimum="0" SmallChange="1" SpinButtonPlacementMode="Inline" />
                                <NumberBox x:Name="TilingMinimumWidthNumber" Grid.Row="1" Grid.Column="0" AutomationProperties.Name="Minimum tile width" Header="Minimum tile width" Maximum="4096" Minimum="64" SmallChange="16" SpinButtonPlacementMode="Inline" />
                                <NumberBox x:Name="TilingMinimumHeightNumber" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="Minimum tile height" Header="Minimum tile height" Maximum="4096" Minimum="64" SmallChange="16" SpinButtonPlacementMode="Inline" />
                            </Grid>
                            <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="Values use 96-DPI units. Existing float and ignore rules are kept unchanged." TextWrapping="Wrap" />
                            <Button x:Name="ApplyTilingButton" HorizontalAlignment="Left" AutomationProperties.Name="Save and apply window tiling" Click="OnApplyTilingClick" Content="Save and apply" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            <InfoBar x:Name="TilingStatus" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" IsClosable="False" IsOpen="False" Title="Window tiling" />

            <TextBlock
                x:Name="DesktopsSectionTitle"
                Margin="0,24,0,10"
                Style="{StaticResource DesktopShift.SectionLabelStyle}"
                Text="Desktops" />
            <Border Style="{StaticResource DesktopShift.GroupCardStyle}">
                <Border Style="{StaticResource DesktopShift.SettingRowStyle}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE7F4;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource DesktopShift.RowTitleStyle}" Text="Name Windows desktops" />
                            <TextBlock Style="{StaticResource DesktopShift.RowDescriptionStyle}" Text="Keep Task View labels synchronized with managed desktop names when supported." />
                        </StackPanel>
                        <ToggleSwitch x:Name="NameWindowsDesktopsToggle" Grid.Column="2" AutomationProperties.Name="Name Windows desktops to match Managed Desktops" OffContent="" OnContent="" Toggled="OnPersistedBehaviorChanged" />
                    </Grid>
                </Border>
            </Border>

            <TextBlock
                x:Name="CompatibilitySectionTitle"
                Margin="0,24,0,10"
                Style="{StaticResource DesktopShift.SectionLabelStyle}"
                Text="Windows compatibility" />
            <Border Style="{StaticResource DesktopShift.GroupCardStyle}">
                <StackPanel>
                    <Border Style="{StaticResource DesktopShift.SettingRowStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xE946;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="ProviderLabel" Style="{StaticResource DesktopShift.RowTitleStyle}" Text="Provider mode" />
                                <TextBlock x:Name="ProviderValue" AutomationProperties.LabeledBy="{x:Bind ProviderLabel}" Style="{StaticResource DesktopShift.RowDescriptionStyle}" />
                            </StackPanel>
                            <TextBlock x:Name="ModeValue" Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource DesktopShift.SuccessBrush}" Style="{StaticResource DesktopShift.RowTitleStyle}" />
                        </Grid>
                    </Border>
                    <Border BorderThickness="0,1,0,0" Style="{StaticResource DesktopShift.SettingRowStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xE950;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="BuildLabel" Style="{StaticResource DesktopShift.RowTitleStyle}" Text="Windows build" />
                                <TextBlock x:Name="BuildValue" AutomationProperties.LabeledBy="{x:Bind BuildLabel}" Style="{StaticResource DesktopShift.RowDescriptionStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock x:Name="BuildSupportLabel" Style="{StaticResource DesktopShift.RowTitleStyle}" Text="Build support" />
                                <TextBlock x:Name="BuildSupportValue" AutomationProperties.LabeledBy="{x:Bind BuildSupportLabel}" Style="{StaticResource DesktopShift.RowDescriptionStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border BorderThickness="0,1,0,0" Style="{StaticResource DesktopShift.SettingRowStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xE7F4;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="CapabilitiesLabel" Style="{StaticResource DesktopShift.RowTitleStyle}" Text="Virtual desktop capabilities" />
                                <TextBlock x:Name="CapabilitiesValue" AutomationProperties.LabeledBy="{x:Bind CapabilitiesLabel}" Style="{StaticResource DesktopShift.RowDescriptionStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border BorderThickness="0,1,0,0" Style="{StaticResource DesktopShift.SettingRowStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xE73E;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource DesktopShift.RowTitleStyle}" Text="Run compatibility test" />
                                <TextBlock x:Name="TestOutcomeValue" Style="{StaticResource DesktopShift.RowDescriptionStyle}" />
                                <TextBlock x:Name="TestSummaryValue" Style="{StaticResource DesktopShift.CaptionStyle}" />
                                <TextBlock x:Name="TestedAtValue" Style="{StaticResource DesktopShift.CaptionStyle}" />
                            </StackPanel>
                            <Button x:Name="RunCompatibilityTestButton" Grid.Column="2" AutomationProperties.Name="Run compatibility test" Click="OnRunCompatibilityTestClick" Content="Run test" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
            <InfoBar x:Name="LimitedModeExplanation" Margin="0,10,0,0" IsClosable="False" IsOpen="True" Severity="Warning" Title="Provider details" />

            <TextBlock
                x:Name="NotificationsSectionTitle"
                Margin="0,24,0,10"
                Style="{StaticResource DesktopShift.SectionLabelStyle}"
                Text="Notifications" />
            <Border Style="{StaticResource DesktopShift.GroupCardStyle}">
                <StackPanel>
                    <Border Style="{StaticResource DesktopShift.SettingRowStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xEA8F;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource DesktopShift.RowTitleStyle}" Text="Assignment failures" />
                                <TextBlock Style="{StaticResource DesktopShift.RowDescriptionStyle}" Text="Notify when DesktopShift cannot place a window." />
                            </StackPanel>
                            <ToggleSwitch x:Name="AssignmentFailureNotificationToggle" Grid.Column="2" AutomationProperties.Name="Notify when a window assignment fails" OffContent="" OnContent="" Toggled="OnPersistedBehaviorChanged" />
                        </Grid>
                    </Border>
                    <Border BorderThickness="0,1,0,0" Style="{StaticResource DesktopShift.SettingRowStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xE7BA;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource DesktopShift.RowTitleStyle}" Text="Compatibility warnings" />
                                <TextBlock Style="{StaticResource DesktopShift.RowDescriptionStyle}" Text="Notify when compatibility is limited or a validation test fails." />
                            </StackPanel>
                            <ToggleSwitch x:Name="CompatibilityWarningNotificationToggle" Grid.Column="2" AutomationProperties.Name="Notify when compatibility is limited or a test fails" OffContent="" OnContent="" Toggled="OnPersistedBehaviorChanged" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock
                x:Name="DiagnosticsSectionTitle"
                Margin="0,24,0,10"
                Style="{StaticResource DesktopShift.SectionLabelStyle}"
                Text="Diagnostics and privacy" />
            <Border Style="{StaticResource DesktopShift.GroupCardStyle}">
                <StackPanel>
                    <Border Style="{StaticResource DesktopShift.SettingRowStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xE9D9;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource DesktopShift.RowTitleStyle}" Text="Record local activity" />
                                <TextBlock Style="{StaticResource DesktopShift.RowDescriptionStyle}" Text="Keep privacy-safe assignment history and rotating troubleshooting logs on this device. Nothing is uploaded." />
                            </StackPanel>
                            <ToggleSwitch x:Name="RecordLocalActivityToggle" Grid.Column="2" AutomationProperties.Name="Record local activity" OffContent="" OnContent="" Toggled="OnPersistedBehaviorChanged" />
                        </Grid>
                    </Border>
                    <Border BorderThickness="0,1,0,0" Style="{StaticResource DesktopShift.SettingRowStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xE8A5;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource DesktopShift.RowTitleStyle}" Text="Local diagnostic logs" />
                                <TextBlock x:Name="DiagnosticLogLocation" IsTextSelectionEnabled="True" Style="{StaticResource DesktopShift.RowDescriptionStyle}" />
                            </StackPanel>
                            <Button Grid.Column="2" AutomationProperties.Name="Open log location" Click="OnOpenLogLocationClick" Content="Open location" />
                        </Grid>
                    </Border>
                    <Border BorderThickness="0,1,0,0" Style="{StaticResource DesktopShift.SettingRowStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xE896;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource DesktopShift.RowTitleStyle}" Text="Export diagnostics" />
                                <TextBlock Style="{StaticResource DesktopShift.RowDescriptionStyle}" Text="Create a local troubleshooting bundle without window titles or browser addresses." />
                            </StackPanel>
                            <Button x:Name="ExportDiagnosticsButton" Grid.Column="2" AutomationProperties.Name="Export diagnostic bundle" Click="OnExportDiagnosticsClick" Content="Export…" />
                        </Grid>
                    </Border>
                    <Border BorderThickness="0,1,0,0" Style="{StaticResource DesktopShift.SettingRowStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xE74D;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource DesktopShift.RowTitleStyle}" Text="Local activity history" />
                                <TextBlock Style="{StaticResource DesktopShift.RowDescriptionStyle}" Text="Clear assignment and diagnostic events stored on this device." />
                            </StackPanel>
                            <Button Grid.Column="2" AutomationProperties.Name="Clear local activity" Click="OnClearActivityClick" Content="Clear activity" />
                        </Grid>
                    </Border>
                    <Border BorderThickness="0,1,0,0" Style="{StaticResource DesktopShift.SettingRowStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xE8B5;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource DesktopShift.RowTitleStyle}" Text="Portable configuration" />
                                <TextBlock Style="{StaticResource DesktopShift.RowDescriptionStyle}" Text="Move editable settings and rules without runtime bindings or profile paths." />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ImportConfigurationButton" AutomationProperties.Name="Import configuration" Click="OnImportConfigurationClick" Content="Import…" />
                                <Button x:Name="ExportConfigurationButton" AutomationProperties.Name="Export configuration" Click="OnExportConfigurationClick" Content="Export…" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock
                x:Name="DesktopSwitchingSectionTitle"
                Margin="0,24,0,10"
                Style="{StaticResource DesktopShift.SectionLabelStyle}"
                Text="Desktop switching shortcut" />
            <Border Style="{StaticResource DesktopShift.GroupCardStyle}">
                <StackPanel>
                    <Border Style="{StaticResource DesktopShift.SettingRowStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xE8AB;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource DesktopShift.RowTitleStyle}" Text="Enable desktop switching shortcuts" />
                                <TextBlock x:Name="DesktopSwitchingSectionDescription" Style="{StaticResource DesktopShift.RowDescriptionStyle}" Text="Use the number row to switch directly to desktops 1 through 10." />
                            </StackPanel>
                            <ToggleSwitch x:Name="DesktopSwitchEnabledToggle" Grid.Column="2" AutomationProperties.Name="Enable desktop switching shortcuts" OffContent="" OnContent="" />
                        </Grid>
                    </Border>
                    <Border Padding="15,12" BorderBrush="{ThemeResource DesktopShift.BorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Spacing="10">
                            <RadioButton x:Name="DesktopSwitchCtrlAltOption" AutomationProperties.Name="Ctrl + Alt + Number, recommended" Checked="OnDesktopSwitchProfileChecked" Content="Ctrl + Alt + Number (recommended)" GroupName="DesktopSwitchProfile" />
                            <RadioButton x:Name="DesktopSwitchCustomOption" AutomationProperties.Name="Custom, choose any combination of Ctrl, Alt, Shift, and Win" Checked="OnDesktopSwitchProfileChecked" Content="Custom modifiers" GroupName="DesktopSwitchProfile" />
                            <StackPanel x:Name="DesktopSwitchCustomModifiers" Margin="32,0,0,0" AutomationProperties.Name="Custom modifiers" Orientation="Horizontal" Spacing="14">
                                <CheckBox x:Name="DesktopSwitchControlModifier" Checked="OnDesktopSwitchModifierChanged" Content="Ctrl" Unchecked="OnDesktopSwitchModifierChanged" />
                                <CheckBox x:Name="DesktopSwitchAltModifier" Checked="OnDesktopSwitchModifierChanged" Content="Alt" Unchecked="OnDesktopSwitchModifierChanged" />
                                <CheckBox x:Name="DesktopSwitchShiftModifier" Checked="OnDesktopSwitchModifierChanged" Content="Shift" Unchecked="OnDesktopSwitchModifierChanged" />
                                <CheckBox x:Name="DesktopSwitchWindowsModifier" Checked="OnDesktopSwitchModifierChanged" Content="Win" Unchecked="OnDesktopSwitchModifierChanged" />
                            </StackPanel>
                            <TextBlock x:Name="DesktopSwitchSummary" AutomationProperties.LiveSetting="Polite" Style="{StaticResource DesktopShift.CaptionStyle}" />
                            <Button x:Name="ApplyDesktopSwitchButton" HorizontalAlignment="Left" AutomationProperties.Name="Apply desktop switching" Click="OnApplyDesktopSwitchClick" Content="Apply desktop switching" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            <InfoBar x:Name="DesktopSwitchStatus" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" IsClosable="False" IsOpen="False" Severity="Warning" Title="Desktop switching shortcuts" />
        </StackPanel>
    </ScrollViewer>
</Page>
