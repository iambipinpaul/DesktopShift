<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DesktopShift.App.Pages.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:config="using:DesktopShift.Core.Configuration"
    xmlns:observation="using:DesktopShift.Core.Observation"
    xmlns:rules="using:DesktopShift.App.Rules"
    AutomationProperties.Name="Application rules page"
    Background="Transparent"
    SizeChanged="OnPageSizeChanged">
    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            x:Name="RulesContent"
            MaxWidth="{StaticResource DesktopShift.PageContentMaxWidth}"
            Margin="{StaticResource DesktopShift.PageMargin}"
            HorizontalAlignment="Center">
            <StackPanel Margin="0,0,0,12" Orientation="Horizontal" Spacing="7">
                <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="DesktopShift" />
                <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="›" />
                <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="Application rules" />
            </StackPanel>

            <Grid
                x:Name="PageHeaderGrid"
                Margin="0,0,0,22"
                ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="{StaticResource DesktopShift.TightSpacing}">
                    <TextBlock Style="{StaticResource DesktopShift.PageTitleStyle}" Text="Application rules" />
                    <TextBlock
                        MaxWidth="700"
                        HorizontalAlignment="Left"
                        Style="{StaticResource DesktopShift.PageSubtitleStyle}"
                        Text="Rules are evaluated using the strongest available application identity." />
                </StackPanel>
                <StackPanel
                    x:Name="HeaderActions"
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="RefreshButton"
                        AutomationProperties.Name="Refresh application rules"
                        Click="OnRefreshClick">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="NewRuleButton"
                        AutomationProperties.Name="Create a new application rule"
                        Click="OnNewRuleClick"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="Add rule" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border
                Margin="0,0,0,14"
                Padding="12"
                Style="{StaticResource DesktopShift.GroupCardStyle}">
                <AutoSuggestBox
                    x:Name="RuleSearchBox"
                    AutomationProperties.Name="Search application rules"
                    PlaceholderText="Search rules"
                    QueryIcon="Find"
                    TextChanged="OnRuleSearchTextChanged" />
            </Border>

            <InfoBar
                x:Name="StatusBar"
                Margin="0,0,0,12"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="Application rule status"
                IsClosable="True"
                IsOpen="False"
                Severity="Success" />
            <InfoBar
                x:Name="ValidationBar"
                Margin="0,0,0,12"
                AutomationProperties.Name="Configuration validation issues"
                IsClosable="False"
                IsOpen="False"
                Severity="Error"
                Title="This configuration is saved but not active" />

            <Border
                x:Name="EmptyState"
                MinHeight="260"
                Style="{StaticResource DesktopShift.CardStyle}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                    <FontIcon
                        HorizontalAlignment="Center"
                        Style="{StaticResource DesktopShift.EmptyStateIconStyle}"
                        Glyph="&#xE8EF;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource DesktopShift.SectionHeadingStyle}"
                        Text="No application rules" />
                    <TextBlock
                        MaxWidth="500"
                        Style="{StaticResource DesktopShift.PageSubtitleStyle}"
                        Text="Create a rule to send an application's windows to a managed desktop."
                        TextAlignment="Center" />
                </StackPanel>
            </Border>

            <ListView
                x:Name="RuleList"
                AutomationProperties.Name="Application rules"
                ItemContainerStyle="{StaticResource DesktopShift.CardListItemStyle}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="config:ApplicationRulePresentation">
                        <Border
                            AutomationProperties.Name="{x:Bind AutomationName}"
                            Style="{StaticResource DesktopShift.ListCardStyle}">
                            <Grid ColumnSpacing="14" SizeChanged="OnRuleCardSizeChanged">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border
                                    Grid.RowSpan="2"
                                    Width="38"
                                    Height="38"
                                    Style="{StaticResource DesktopShift.IconTileStyle}">
                                    <Grid>
                                        <Image
                                            Width="22"
                                            Height="22"
                                            Source="{x:Bind rules:RuleIconSource.Create(Icon)}"
                                            Visibility="{x:Bind rules:RuleIconSource.IconVisibility(Icon)}" />
                                        <FontIcon
                                            Style="{StaticResource DesktopShift.IconTileGlyphStyle}"
                                            Glyph="{x:Bind FallbackGlyph}"
                                            Visibility="{x:Bind rules:RuleIconSource.GlyphVisibility(Icon)}" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                    <TextBlock Style="{StaticResource DesktopShift.RowTitleStyle}" Text="{x:Bind DisplayName}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="{x:Bind MatchSummary}" />
                                        <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="•" />
                                        <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="{x:Bind TargetSummary}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel
                                    x:Name="RuleActions"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="9">
                                    <ToggleSwitch
                                        MinWidth="40"
                                        AutomationProperties.HelpText="{x:Bind DisplayName}"
                                        AutomationProperties.Name="Rule enabled"
                                        IsOn="{x:Bind IsEnabled}"
                                        OffContent=""
                                        OnContent=""
                                        Tag="{x:Bind RuleId}"
                                        Toggled="OnRuleEnabledToggled" />
                                    <Button
                                        AutomationProperties.HelpText="{x:Bind DisplayName}"
                                        AutomationProperties.Name="Edit rule"
                                        Click="OnEditRuleClick"
                                        Tag="{x:Bind RuleId}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                            <TextBlock Text="Edit" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Width="34"
                                        Padding="0"
                                        AutomationProperties.HelpText="{x:Bind DisplayName}"
                                        AutomationProperties.Name="More rule actions">
                                        <FontIcon FontSize="16" Glyph="&#xE712;" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem
                                                    Click="OnReassignRuleClick"
                                                    Tag="{x:Bind RuleId}"
                                                    Text="Test and reassign" />
                                                <MenuFlyoutItem
                                                    Click="OnDuplicateRuleClick"
                                                    Tag="{x:Bind RuleId}"
                                                    Text="Duplicate" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem
                                                    Click="OnDeleteRuleClick"
                                                    Tag="{x:Bind RuleId}"
                                                    Text="Delete" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Margin="0,26,0,0" Spacing="12">
                <StackPanel Spacing="5">
                    <TextBlock
                        Style="{StaticResource DesktopShift.SectionHeadingStyle}"
                        Text="Windows-managed windows" />
                    <TextBlock
                        MaxWidth="760"
                        HorizontalAlignment="Left"
                        Style="{StaticResource DesktopShift.PageSubtitleStyle}"
                        Text="Windows controls these native surfaces. DesktopShift leaves them where Windows opens them, and this safety list cannot be changed." />
                </StackPanel>
                <ListView
                    AutomationProperties.Name="Windows-managed windows"
                    ItemsSource="{x:Bind WindowsManagedWindows, Mode=OneTime}"
                    ItemContainerStyle="{StaticResource DesktopShift.CardListItemStyle}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="observation:WindowsManagedWindowEntry">
                            <Border
                                AutomationProperties.Name="{x:Bind DisplayName}"
                                Style="{StaticResource DesktopShift.ListCardStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="38"
                                        Height="38"
                                        Style="{StaticResource DesktopShift.IconTileStyle}">
                                        <FontIcon FontSize="17" Glyph="&#xE72E;" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                        <TextBlock
                                            Style="{StaticResource DesktopShift.RowTitleStyle}"
                                            Text="{x:Bind DisplayName}" />
                                        <TextBlock
                                            TextWrapping="Wrap"
                                            Style="{StaticResource DesktopShift.CaptionStyle}"
                                            Text="{x:Bind Description}" />
                                        <TextBlock
                                            TextWrapping="Wrap"
                                            Style="{StaticResource DesktopShift.CaptionStyle}"
                                            Text="{x:Bind ProcessSummary}" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <FontIcon FontSize="13" Glyph="&#xE72E;" />
                                        <TextBlock
                                            Style="{StaticResource DesktopShift.CaptionStyle}"
                                            Text="Built in" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
