<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DesktopShift.App.Pages.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:config="using:DesktopShift.Core.Configuration"
    xmlns:rules="using:DesktopShift.App.Rules"
    AutomationProperties.Name="Application Rules page"
    Background="Transparent">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="960" Margin="32,28" HorizontalAlignment="Left" Spacing="20">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="5">
                    <TextBlock Style="{StaticResource DesktopShift.PageTitleStyle}" Text="Application Rules" />
                    <TextBlock
                        Style="{StaticResource DesktopShift.PageSubtitleStyle}"
                        Text="Every rule DesktopShift matches windows against, strongest identity first. Add, edit, duplicate, or turn a rule off, then prove it against the windows you have open." />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="RefreshButton"
                        AutomationProperties.Name="Refresh application rules"
                        Click="OnRefreshClick"
                        Content="Refresh" />
                    <Button
                        x:Name="NewRuleButton"
                        AutomationProperties.Name="Create a new application rule"
                        Click="OnNewRuleClick"
                        Content="New rule"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>

            <InfoBar
                x:Name="StatusBar"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="Application rule status"
                IsClosable="True"
                IsOpen="False"
                Severity="Success" />

            <InfoBar
                x:Name="ValidationBar"
                AutomationProperties.Name="Configuration validation issues"
                IsClosable="False"
                IsOpen="False"
                Severity="Error"
                Title="This configuration is saved but not active" />

            <Border
                x:Name="EmptyState"
                MinHeight="260"
                Style="{StaticResource DesktopShift.CardStyle}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <FontIcon Style="{StaticResource DesktopShift.EmptyStateIconStyle}" Glyph="&#xE8EF;" />
                    <TextBlock Style="{StaticResource DesktopShift.SectionTitleStyle}" Text="No application rules" />
                    <TextBlock
                        MaxWidth="500"
                        TextAlignment="Center"
                        Style="{StaticResource DesktopShift.PageSubtitleStyle}"
                        Text="Create a rule to send an application's windows to a Managed Desktop." />
                </StackPanel>
            </Border>

            <ListView
                x:Name="RuleList"
                AutomationProperties.Name="Application rules"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="config:ApplicationRulePresentation">
                        <Border
                            AutomationProperties.Name="{x:Bind AutomationName}"
                            Style="{StaticResource DesktopShift.CardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="42"
                                    Height="42"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource DesktopShift.AccentSoftBrush}"
                                    CornerRadius="10">
                                    <Grid>
                                        <Image
                                            Width="26"
                                            Height="26"
                                            AutomationProperties.AccessibilityView="Raw"
                                            Source="{x:Bind rules:RuleIconSource.Create(Icon)}"
                                            Visibility="{x:Bind rules:RuleIconSource.IconVisibility(Icon)}" />
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AccessibilityView="Raw"
                                            Foreground="{ThemeResource DesktopShift.AccentStrongBrush}"
                                            Glyph="{x:Bind FallbackGlyph}"
                                            Visibility="{x:Bind rules:RuleIconSource.GlyphVisibility(Icon)}" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock
                                                Style="{StaticResource DesktopShift.SectionTitleStyle}"
                                                Text="{x:Bind DisplayName}" />
                                            <TextBlock
                                                Style="{StaticResource DesktopShift.CaptionStyle}"
                                                Text="{x:Bind IdentityStrengthLabel}" />
                                        </StackPanel>
                                        <Border
                                            Grid.Column="1"
                                            Padding="11,5"
                                            VerticalAlignment="Top"
                                            Background="{ThemeResource DesktopShift.AccentSoftBrush}"
                                            CornerRadius="999">
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource DesktopShift.TextPrimaryBrush}"
                                                Text="{x:Bind EnabledLabel}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock
                                        TextWrapping="Wrap"
                                        Style="{StaticResource DesktopShift.BodyStyle}"
                                        Text="{x:Bind MatchSummary}" />
                                    <TextBlock
                                        TextWrapping="Wrap"
                                        Style="{StaticResource DesktopShift.CaptionStyle}"
                                        Text="{x:Bind TargetSummary}" />
                                    <TextBlock
                                        TextWrapping="Wrap"
                                        Style="{StaticResource DesktopShift.CaptionStyle}"
                                        Text="{x:Bind TriggerSummary}" />
                                    <TextBlock
                                        TextWrapping="Wrap"
                                        Style="{StaticResource DesktopShift.CaptionStyle}"
                                        Text="{x:Bind SwitchPolicySummary}" />
                                    <TextBlock
                                        Style="{StaticResource DesktopShift.CaptionStyle}"
                                        Text="{x:Bind LastMatchSummary}" />
                                    <Expander
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        AutomationProperties.Name="{x:Bind DisplayName}"
                                        Header="Advanced details">
                                        <TextBlock
                                            Padding="0,8,0,2"
                                            AutomationProperties.Name="Declared rule identities"
                                            FontFamily="Consolas"
                                            IsTextSelectionEnabled="True"
                                            TextWrapping="Wrap"
                                            Style="{StaticResource DesktopShift.BodyStyle}"
                                            Text="{x:Bind AdvancedDetails}" />
                                    </Expander>
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Top"
                                    Spacing="8">
                                    <ToggleSwitch
                                        AutomationProperties.Name="Rule enabled"
                                        IsOn="{x:Bind IsEnabled}"
                                        OffContent="Disabled"
                                        OnContent="Enabled"
                                        Tag="{x:Bind RuleId}"
                                        Toggled="OnRuleEnabledToggled" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button
                                            AutomationProperties.Name="Edit rule"
                                            Click="OnEditRuleClick"
                                            Content="Edit"
                                            Tag="{x:Bind RuleId}" />
                                        <Button
                                            AutomationProperties.Name="Duplicate rule"
                                            Click="OnDuplicateRuleClick"
                                            Content="Duplicate"
                                            Tag="{x:Bind RuleId}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button
                                            AutomationProperties.Name="Test this rule and reassign its matching windows"
                                            Click="OnReassignRuleClick"
                                            Content="Test and reassign"
                                            Tag="{x:Bind RuleId}" />
                                        <Button
                                            AutomationProperties.Name="Delete rule"
                                            Click="OnDeleteRuleClick"
                                            Content="Delete"
                                            Tag="{x:Bind RuleId}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
