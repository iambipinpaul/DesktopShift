<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DesktopShift.App.Pages.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:config="using:DesktopShift.Core.Configuration"
    xmlns:rules="using:DesktopShift.App.Rules"
    AutomationProperties.Name="Application rules page"
    Background="Transparent">
    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="{StaticResource DesktopShift.PageContentMaxWidth}"
            Margin="{StaticResource DesktopShift.PageMargin}"
            HorizontalAlignment="Center"
            Spacing="{StaticResource DesktopShift.SectionSpacing}">
            <StackPanel Margin="0,0,0,-12" Orientation="Horizontal" Spacing="7">
                <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="DesktopShift" />
                <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="›" />
                <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="Application rules" />
            </StackPanel>
            <Grid ColumnSpacing="{StaticResource DesktopShift.CardSpacing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="{StaticResource DesktopShift.TightSpacing}">
                    <TextBlock Style="{StaticResource DesktopShift.PageTitleStyle}" Text="Application rules" />
                    <TextBlock
                        Style="{StaticResource DesktopShift.PageSubtitleStyle}"
                        Text="Every rule DesktopShift matches windows against, strongest identity first. Add, edit, duplicate, or turn a rule off, then prove it against the windows you have open." />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Spacing="{StaticResource DesktopShift.ItemSpacing}">
                    <Button
                        x:Name="RefreshButton"
                        AutomationProperties.Name="Refresh application rules"
                        Click="OnRefreshClick"
                        Content="Refresh" />
                    <Button
                        x:Name="NewRuleButton"
                        AutomationProperties.Name="Create a new application rule"
                        Click="OnNewRuleClick"
                        Content="New rule"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>

            <InfoBar
                x:Name="StatusBar"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="Application rule status"
                IsClosable="True"
                IsOpen="False"
                Severity="Success" />

            <InfoBar
                x:Name="ValidationBar"
                AutomationProperties.Name="Configuration validation issues"
                IsClosable="False"
                IsOpen="False"
                Severity="Error"
                Title="This configuration is saved but not active" />

            <Border
                x:Name="EmptyState"
                MinHeight="260"
                Style="{StaticResource DesktopShift.CardStyle}">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="{StaticResource DesktopShift.GroupSpacing}">
                    <FontIcon
                        HorizontalAlignment="Center"
                        Style="{StaticResource DesktopShift.EmptyStateIconStyle}"
                        Glyph="&#xE8EF;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource DesktopShift.SectionHeadingStyle}"
                        Text="No application rules" />
                    <TextBlock
                        MaxWidth="500"
                        Style="{StaticResource DesktopShift.PageSubtitleStyle}"
                        Text="Create a rule to send an application's windows to a Managed Desktop."
                        TextAlignment="Center" />
                </StackPanel>
            </Border>

            <ListView
                x:Name="RuleList"
                AutomationProperties.Name="Application rules"
                ItemContainerStyle="{StaticResource DesktopShift.CardListItemStyle}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="config:ApplicationRulePresentation">
                        <Border
                            AutomationProperties.Name="{x:Bind AutomationName}"
                            Style="{StaticResource DesktopShift.CardStyle}">
                            <Grid ColumnSpacing="{StaticResource DesktopShift.CardSpacing}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource DesktopShift.IconTileStyle}">
                                    <Grid>
                                        <Image
                                            Width="24"
                                            Height="24"
                                            AutomationProperties.AccessibilityView="Raw"
                                            Source="{x:Bind rules:RuleIconSource.Create(Icon)}"
                                            Visibility="{x:Bind rules:RuleIconSource.IconVisibility(Icon)}" />
                                        <FontIcon
                                            Style="{StaticResource DesktopShift.IconTileGlyphStyle}"
                                            Glyph="{x:Bind FallbackGlyph}"
                                            Visibility="{x:Bind rules:RuleIconSource.GlyphVisibility(Icon)}" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="{StaticResource DesktopShift.ItemSpacing}">
                                    <Grid ColumnSpacing="{StaticResource DesktopShift.GroupSpacing}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="{StaticResource DesktopShift.TightSpacing}">
                                            <TextBlock
                                                Style="{StaticResource DesktopShift.SectionTitleStyle}"
                                                Text="{x:Bind DisplayName}" />
                                            <TextBlock
                                                Style="{StaticResource DesktopShift.CaptionStyle}"
                                                Text="{x:Bind IdentityStrengthLabel}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource DesktopShift.PillStyle}">
                                            <TextBlock
                                                Style="{StaticResource DesktopShift.PillTextStyle}"
                                                Text="{x:Bind EnabledLabel}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock
                                        Style="{StaticResource DesktopShift.BodyStyle}"
                                        Text="{x:Bind MatchSummary}" />
                                    <TextBlock
                                        Style="{StaticResource DesktopShift.CaptionStyle}"
                                        Text="{x:Bind TargetSummary}" />
                                    <TextBlock
                                        Style="{StaticResource DesktopShift.CaptionStyle}"
                                        Text="{x:Bind TriggerSummary}" />
                                    <TextBlock
                                        Style="{StaticResource DesktopShift.CaptionStyle}"
                                        Text="{x:Bind SwitchPolicySummary}" />
                                    <TextBlock
                                        Style="{StaticResource DesktopShift.CaptionStyle}"
                                        Text="{x:Bind LastMatchSummary}" />
                                    <!--
                                        Every row shows the same words on its
                                        controls, so the rule's name rides along
                                        as help text. A screen reader then says
                                        which rule it is about to expand, edit,
                                        or delete instead of repeating "Delete
                                        rule" down the whole list.
                                    -->
                                    <Expander
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        AutomationProperties.HelpText="{x:Bind DisplayName}"
                                        Header="Advanced details">
                                        <!--
                                            No accessible name of its own: a name
                                            on a TextBlock replaces the text it is
                                            meant to introduce, and the expander
                                            around it has already said what it
                                            holds and which rule it belongs to.
                                        -->
                                        <TextBlock
                                            Padding="0,8,0,2"
                                            Style="{StaticResource DesktopShift.MonospaceStyle}"
                                            Text="{x:Bind AdvancedDetails}" />
                                    </Expander>
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Top"
                                    Spacing="{StaticResource DesktopShift.ItemSpacing}">
                                    <ToggleSwitch
                                        AutomationProperties.HelpText="{x:Bind DisplayName}"
                                        AutomationProperties.Name="Rule enabled"
                                        IsOn="{x:Bind IsEnabled}"
                                        OffContent="Disabled"
                                        OnContent="Enabled"
                                        Tag="{x:Bind RuleId}"
                                        Toggled="OnRuleEnabledToggled" />
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource DesktopShift.ItemSpacing}">
                                        <Button
                                            AutomationProperties.HelpText="{x:Bind DisplayName}"
                                            AutomationProperties.Name="Edit rule"
                                            Click="OnEditRuleClick"
                                            Content="Edit"
                                            Tag="{x:Bind RuleId}" />
                                        <Button
                                            AutomationProperties.HelpText="{x:Bind DisplayName}"
                                            AutomationProperties.Name="Duplicate rule"
                                            Click="OnDuplicateRuleClick"
                                            Content="Duplicate"
                                            Tag="{x:Bind RuleId}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource DesktopShift.ItemSpacing}">
                                        <Button
                                            AutomationProperties.HelpText="{x:Bind DisplayName}"
                                            AutomationProperties.Name="Test this rule and reassign its matching windows"
                                            Click="OnReassignRuleClick"
                                            Content="Test and reassign"
                                            Tag="{x:Bind RuleId}" />
                                        <Button
                                            AutomationProperties.HelpText="{x:Bind DisplayName}"
                                            AutomationProperties.Name="Delete rule"
                                            Click="OnDeleteRuleClick"
                                            Content="Delete"
                                            Tag="{x:Bind RuleId}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
