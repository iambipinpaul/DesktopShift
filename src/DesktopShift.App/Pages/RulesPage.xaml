<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DesktopShift.App.Pages.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:DesktopShift.App.ViewModels"
    AutomationProperties.Name="Application Rules page"
    Background="Transparent">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="960" Margin="32,28" HorizontalAlignment="Left" Spacing="20">
            <StackPanel Spacing="5">
                <TextBlock Style="{StaticResource DesktopShift.PageTitleStyle}" Text="Application Rules" />
                <TextBlock Style="{StaticResource DesktopShift.PageSubtitleStyle}" Text="The persisted rules DesktopShift will use when assignment processing becomes available." />
            </StackPanel>
            <Border
                x:Name="EmptyState"
                MinHeight="260"
                Style="{StaticResource DesktopShift.CardStyle}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <FontIcon Style="{StaticResource DesktopShift.EmptyStateIconStyle}" Glyph="&#xE8EF;" />
                    <TextBlock Style="{StaticResource DesktopShift.SectionTitleStyle}" Text="No persisted rules" />
                    <TextBlock
                        MaxWidth="500"
                        TextAlignment="Center"
                        Style="{StaticResource DesktopShift.PageSubtitleStyle}"
                        Text="Complete first-run setup to save the starter application rules." />
                </StackPanel>
            </Border>
            <ListView
                x:Name="RuleList"
                AutomationProperties.Name="Persisted application rules"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:RulePresentation">
                        <Border Style="{StaticResource DesktopShift.CardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="5">
                                    <TextBlock Style="{StaticResource DesktopShift.SectionTitleStyle}" Text="{x:Bind DisplayName}" />
                                    <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="{x:Bind ProcessNames}" />
                                    <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="{x:Bind TargetDesktop}" />
                                </StackPanel>
                                <Border
                                    Grid.Column="1"
                                    Padding="11,5"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource DesktopShift.AccentSoftBrush}"
                                    CornerRadius="999">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource DesktopShift.TextPrimaryBrush}"
                                        Text="{x:Bind Status}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
