<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DesktopShift.App.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.Name="About DesktopShift page"
    Background="Transparent">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="{StaticResource DesktopShift.PageContentMaxWidth}"
            Margin="{StaticResource DesktopShift.PageMargin}"
            HorizontalAlignment="Left"
            Spacing="{StaticResource DesktopShift.SectionSpacing}">
            <StackPanel Spacing="{StaticResource DesktopShift.TightSpacing}">
                <TextBlock Style="{StaticResource DesktopShift.PageTitleStyle}" Text="About DesktopShift" />
                <TextBlock Style="{StaticResource DesktopShift.PageSubtitleStyle}" Text="A focused Windows companion for keeping application windows where they belong." />
            </StackPanel>
            <Border Style="{StaticResource DesktopShift.CardStyle}">
                <StackPanel Spacing="{StaticResource DesktopShift.CardSpacing}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource DesktopShift.GroupSpacing}">
                        <Border Style="{StaticResource DesktopShift.IconTileStyle}">
                            <FontIcon
                                Style="{StaticResource DesktopShift.IconTileGlyphStyle}"
                                FontSize="20"
                                Glyph="&#xE8B7;" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="{StaticResource DesktopShift.TightSpacing}">
                            <TextBlock Style="{StaticResource DesktopShift.SectionHeadingStyle}" Text="DesktopShift" />
                            <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="Preview foundation • .NET 10 • WinUI 3" />
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource DesktopShift.SeparatorStyle}" />
                    <TextBlock
                        MaxWidth="650"
                        Style="{StaticResource DesktopShift.BodyStyle}"
                        Text="DesktopShift is designed to make a multi-desktop Windows workspace feel predictable without taking control away from you. Only explicitly managed desktops and rules participate in automation." />
                    <TextBlock
                        Style="{StaticResource DesktopShift.CaptionStyle}"
                        Text="© 2026 Bipin Paul. All rights reserved." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
