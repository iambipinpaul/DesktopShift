<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DesktopShift.App.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.Name="About page"
    Background="Transparent"
    SizeChanged="OnPageSizeChanged">

    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            x:Name="AboutContent"
            MaxWidth="{StaticResource DesktopShift.PageContentMaxWidth}"
            Margin="{StaticResource DesktopShift.PageMargin}"
            HorizontalAlignment="Center">

            <StackPanel Margin="0,0,0,12" Orientation="Horizontal" Spacing="7">
                <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="DesktopShift" />
                <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="›" />
                <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="About" />
            </StackPanel>

            <StackPanel Margin="0,0,0,22" Spacing="4">
                <TextBlock Style="{StaticResource DesktopShift.PageTitleStyle}" Text="About" />
                <TextBlock
                    Style="{StaticResource DesktopShift.PageSubtitleStyle}"
                    Text="Product information, runtime details, compatibility, and privacy." />
            </StackPanel>

            <Border
                Margin="0,0,0,24"
                Padding="20"
                Style="{StaticResource DesktopShift.CardStyle}">
                <Grid x:Name="ProductHeroGrid" ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Image
                        Width="56"
                        Height="56"
                        AutomationProperties.AccessibilityView="Raw"
                        Source="ms-appx:///Assets/DesktopShiftLogo.svg"
                        Stretch="Uniform" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock
                            FontSize="22"
                            Style="{StaticResource DesktopShift.SectionHeadingStyle}"
                            Text="DesktopShift" />
                        <TextBlock x:Name="VersionSummary" Style="{StaticResource DesktopShift.CaptionStyle}" />
                    </StackPanel>

                    <Border
                        x:Name="PlatformPill"
                        Grid.Column="2"
                        HorizontalAlignment="Left"
                        Style="{StaticResource DesktopShift.PillStyle}">
                        <TextBlock Style="{StaticResource DesktopShift.PillTextStyle}" Text="Windows 11" />
                    </Border>

                    <TextBlock
                        Grid.Row="1"
                        Grid.ColumnSpan="3"
                        MaxWidth="760"
                        HorizontalAlignment="Left"
                        Style="{StaticResource DesktopShift.BodyStyle}"
                        Text="Keep application windows organized on purpose-built Windows desktops—without intercepting how other applications launch." />

                    <StackPanel
                        x:Name="ProductLinksPanel"
                        Grid.Row="2"
                        Grid.ColumnSpan="3"
                        Orientation="Horizontal"
                        Spacing="8">
                        <HyperlinkButton
                            Padding="10,6"
                            AutomationProperties.Name="Open DesktopShift documentation"
                            Content="Read documentation"
                            NavigateUri="https://github.com/iambipinpaul/DesktopShift#readme" />
                        <HyperlinkButton
                            Padding="10,6"
                            AutomationProperties.Name="Open DesktopShift source repository"
                            Content="View source"
                            NavigateUri="https://github.com/iambipinpaul/DesktopShift" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource DesktopShift.SectionLabelStyle}" Text="Runtime environment" />
            <Grid
                x:Name="RuntimeFactsGrid"
                Margin="0,0,0,24"
                ColumnSpacing="12"
                RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="RuntimeFactCard"
                    Padding="15,13"
                    Background="{ThemeResource DesktopShift.SurfaceSecondaryBrush}"
                    Style="{StaticResource DesktopShift.CardStyle}">
                    <StackPanel Spacing="5">
                        <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="RUNTIME" />
                        <TextBlock
                            x:Name="RuntimeValue"
                            FontFamily="Segoe UI Variable Display"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource DesktopShift.TextPrimaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    x:Name="ArchitectureFactCard"
                    Grid.Column="1"
                    Padding="15,13"
                    Background="{ThemeResource DesktopShift.SurfaceSecondaryBrush}"
                    Style="{StaticResource DesktopShift.CardStyle}">
                    <StackPanel Spacing="5">
                        <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="ARCHITECTURE" />
                        <TextBlock
                            x:Name="ArchitectureValue"
                            FontFamily="Segoe UI Variable Display"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource DesktopShift.TextPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <Border
                    x:Name="WindowsBuildFactCard"
                    Grid.Row="1"
                    Padding="15,13"
                    Background="{ThemeResource DesktopShift.SurfaceSecondaryBrush}"
                    Style="{StaticResource DesktopShift.CardStyle}">
                    <StackPanel Spacing="5">
                        <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="CURRENT WINDOWS BUILD" />
                        <TextBlock
                            x:Name="WindowsBuildValue"
                            FontFamily="Segoe UI Variable Display"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource DesktopShift.TextPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <Border
                    x:Name="SupportedBuildFactCard"
                    Grid.Row="1"
                    Grid.Column="1"
                    Padding="15,13"
                    Background="{ThemeResource DesktopShift.SurfaceSecondaryBrush}"
                    Style="{StaticResource DesktopShift.CardStyle}">
                    <StackPanel Spacing="5">
                        <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="SUPPORTED WINDOWS BUILDS" />
                        <TextBlock
                            FontFamily="Segoe UI Variable Display"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource DesktopShift.TextPrimaryBrush}"
                            Text="22621 and later"
                            TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="Tested through build 28000" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Style="{StaticResource DesktopShift.SectionLabelStyle}" Text="Compatibility modes" />
            <Grid
                x:Name="CompatibilityCardsGrid"
                Margin="0,0,0,24"
                ColumnSpacing="12"
                RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="FullModeCard" Padding="16" Style="{StaticResource DesktopShift.CardStyle}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource DesktopShift.IconTileStyle}">
                                <FontIcon Style="{StaticResource DesktopShift.IconTileGlyphStyle}" Glyph="&#xE73E;" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource DesktopShift.RowTitleStyle}" Text="Full Mode" />
                                <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="Complete automation" />
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            Style="{StaticResource DesktopShift.BodyStyle}"
                            Text="Uses the validated Windows adapter to enumerate, create, switch, and move across virtual desktops." />
                    </StackPanel>
                </Border>

                <Border
                    x:Name="LimitedModeCard"
                    Grid.Column="1"
                    Padding="16"
                    Style="{StaticResource DesktopShift.CardStyle}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource DesktopShift.IconTileStyle}">
                                <FontIcon Style="{StaticResource DesktopShift.IconTileGlyphStyle}" Glyph="&#xE7BA;" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource DesktopShift.RowTitleStyle}" Text="Limited Mode" />
                                <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="Safe fallback" />
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            Style="{StaticResource DesktopShift.BodyStyle}"
                            Text="Keeps documented window movement available and disables private desktop operations that did not validate." />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Style="{StaticResource DesktopShift.SectionLabelStyle}" Text="Privacy" />
            <Border Margin="0,0,0,16" Padding="18" Style="{StaticResource DesktopShift.CardStyle}">
                <Grid ColumnSpacing="14" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource DesktopShift.IconTileStyle}">
                        <FontIcon Style="{StaticResource DesktopShift.IconTileGlyphStyle}" Glyph="&#xE946;" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Style="{StaticResource DesktopShift.SectionHeadingStyle}" Text="Privacy by design" />
                        <TextBlock
                            Style="{StaticResource DesktopShift.CaptionStyle}"
                            Text="DesktopShift records only what is needed to explain workspace decisions." />
                    </StackPanel>

                    <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource DesktopShift.SeparatorStyle}" />

                    <Grid
                        x:Name="PrivacyPointsGrid"
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        ColumnSpacing="24"
                        RowSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel x:Name="PrivacyIdentityPoint" Spacing="4">
                            <TextBlock Style="{StaticResource DesktopShift.RowTitleStyle}" Text="Application identity only" />
                            <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="Rules and activity use privacy-safe process and package identity." />
                        </StackPanel>
                        <StackPanel x:Name="PrivacyLocalPoint" Grid.Column="1" Spacing="4">
                            <TextBlock Style="{StaticResource DesktopShift.RowTitleStyle}" Text="Local by default" />
                            <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="Diagnostics stay on this device until you choose to export them." />
                        </StackPanel>
                        <StackPanel x:Name="PrivacyExcludedPoint" Grid.Column="2" Spacing="4">
                            <TextBlock Style="{StaticResource DesktopShift.RowTitleStyle}" Text="Sensitive context excluded" />
                            <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="Titles, URLs, command lines, and profile paths are not logged by default." />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource DesktopShift.CaptionStyle}"
                Text="© 2026 Bipin Paul · DesktopShift" />
        </StackPanel>
    </ScrollViewer>
</Page>
