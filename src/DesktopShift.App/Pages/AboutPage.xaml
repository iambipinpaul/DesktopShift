<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DesktopShift.App.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.Name="About DesktopShift page"
    Background="Transparent">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="960" Margin="32,28" HorizontalAlignment="Left" Spacing="20">
            <StackPanel Spacing="5">
                <TextBlock Style="{StaticResource DesktopShift.PageTitleStyle}" Text="About DesktopShift" />
                <TextBlock Style="{StaticResource DesktopShift.PageSubtitleStyle}" Text="A focused Windows companion for keeping application windows where they belong." />
            </StackPanel>
            <Border Style="{StaticResource DesktopShift.CardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border
                            Width="42"
                            Height="42"
                            Background="{ThemeResource DesktopShift.AccentSoftBrush}"
                            CornerRadius="12">
                            <FontIcon
                                FontSize="20"
                                Foreground="{ThemeResource DesktopShift.AccentStrongBrush}"
                                Glyph="&#xE8B7;" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource DesktopShift.SectionTitleStyle}" Text="DesktopShift" />
                            <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="Preview foundation • .NET 10 • WinUI 3" />
                        </StackPanel>
                    </StackPanel>
                    <Rectangle Height="1" Fill="{ThemeResource DesktopShift.BorderBrush}" />
                    <TextBlock
                        MaxWidth="650"
                        Style="{StaticResource DesktopShift.BodyStyle}"
                        Text="DesktopShift is designed to make a multi-desktop Windows workspace feel predictable without taking control away from you. Only explicitly managed desktops and rules participate in automation." />
                    <TextBlock
                        Style="{StaticResource DesktopShift.CaptionStyle}"
                        Text="© 2026 Bipin Paul. All rights reserved." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
