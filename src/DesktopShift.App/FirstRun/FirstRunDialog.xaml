<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="DesktopShift.App.FirstRun.FirstRunDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:rules="using:DesktopShift.App.Rules"
    xmlns:viewModels="using:DesktopShift.App.ViewModels"
    MinWidth="700"
    MaxWidth="820"
    AutomationProperties.Name="Welcome to DesktopShift"
    CloseButtonText="Not now"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonText="Apply and continue">

    <ScrollViewer MaxHeight="690" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="{StaticResource DesktopShift.SectionSpacing}">
            <StackPanel Spacing="{StaticResource DesktopShift.ItemSpacing}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource DesktopShift.GroupSpacing}">
                    <Image
                        Width="40"
                        Height="40"
                        AutomationProperties.AccessibilityView="Raw"
                        Source="ms-appx:///Assets/DesktopShiftLogo.svg"
                        Stretch="Uniform" />
                    <StackPanel VerticalAlignment="Center" Spacing="{StaticResource DesktopShift.TightSpacing}">
                        <TextBlock Style="{StaticResource DesktopShift.PageTitleStyle}" Text="Welcome to DesktopShift" />
                        <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="REVIEW BEFORE ANYTHING MOVES" />
                    </StackPanel>
                </StackPanel>
                <TextBlock
                    Style="{StaticResource DesktopShift.PageSubtitleStyle}"
                    Text="DesktopShift keeps application windows on purpose-built Windows desktops. Review these starter mappings; nothing is applied until you continue." />
            </StackPanel>

            <InfoBar
                AutomationProperties.Name="First run validation issues"
                IsClosable="False"
                IsIconVisible="True"
                IsOpen="{x:Bind ViewModel.HasValidationIssues, Mode=OneWay}"
                Message="{x:Bind ViewModel.ValidationSummary, Mode=OneWay}"
                Severity="Error"
                Title="Check the highlighted configuration" />

            <Border Style="{StaticResource DesktopShift.CardStyle}">
                <Grid ColumnSpacing="{StaticResource DesktopShift.CardSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Top"
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="20"
                        Foreground="{ThemeResource DesktopShift.WarningBrush}"
                        Glyph="&#xE7BA;" />
                    <StackPanel Grid.Column="1" Spacing="{StaticResource DesktopShift.TightSpacing}">
                        <TextBlock
                            FontWeight="SemiBold"
                            Style="{StaticResource DesktopShift.BodyStyle}"
                            Text="{x:Bind ViewModel.Compatibility.Mode, Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource DesktopShift.CaptionStyle}"
                            Text="{x:Bind ViewModel.Compatibility.Explanation, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Top"
                        Style="{StaticResource DesktopShift.CaptionStyle}"
                        Text="{x:Bind ViewModel.Compatibility.Build, Mode=OneWay}" />
                </Grid>
            </Border>

            <StackPanel Spacing="{StaticResource DesktopShift.ItemSpacing}">
                <TextBlock Style="{StaticResource DesktopShift.SectionHeadingStyle}" Text="Starter mappings" />
                <TextBlock Style="{StaticResource DesktopShift.PageSubtitleStyle}" Text="Rename a desktop, adjust executable names, or turn off any mapping you do not want." />
            </StackPanel>

            <ListView
                AutomationProperties.Name="Starter mappings"
                IsItemClickEnabled="False"
                ItemContainerStyle="{StaticResource DesktopShift.CardListItemStyle}"
                ItemsSource="{x:Bind ViewModel.Mappings, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:FirstRunMappingViewModel">
                        <Border Style="{StaticResource DesktopShift.CardStyle}">
                            <Grid ColumnSpacing="{StaticResource DesktopShift.CardSpacing}" RowSpacing="{StaticResource DesktopShift.GroupSpacing}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource DesktopShift.TightSpacing}">
                                    <TextBlock
                                        Style="{StaticResource DesktopShift.SectionTitleStyle}"
                                        Text="{x:Bind RuleName, Mode=OneWay}" />
                                    <TextBlock
                                        Style="{StaticResource DesktopShift.CaptionStyle}"
                                        Text="{x:Bind DestinationSummary, Mode=OneWay}" />
                                    <TextBlock
                                        Style="{StaticResource DesktopShift.CaptionStyle}"
                                        Text="{x:Bind IdentitySummary, Mode=OneWay}"
                                        Visibility="{x:Bind rules:RuleIconSource.TextVisibility(IdentitySummary), Mode=OneWay}" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{x:Bind RuleName, Mode=OneWay}"
                                    IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                    OffContent="Disabled"
                                    OnContent="Enabled" />
                                <Grid
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    ColumnSpacing="{StaticResource DesktopShift.GroupSpacing}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="3*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        AutomationProperties.HelpText="{x:Bind RuleName, Mode=OneWay}"
                                        AutomationProperties.Name="Managed desktop"
                                        Header="Managed desktop"
                                        Text="{x:Bind DesktopName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Visibility="{x:Bind rules:RuleIconSource.WhenTrue(IsDesktopNameEditable), Mode=OneWay}" />
                                    <StackPanel
                                        Spacing="{StaticResource DesktopShift.TightSpacing}"
                                        Visibility="{x:Bind rules:RuleIconSource.WhenTrue(AllowsAnywhere), Mode=OneWay}">
                                        <TextBlock Style="{StaticResource DesktopShift.FieldLabelStyle}" Text="Managed desktop" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource DesktopShift.BodyStyle}"
                                            Text="Not used — never moved" />
                                    </StackPanel>
                                    <TextBox
                                        Grid.Column="1"
                                        AutomationProperties.HelpText="Separate multiple executable names with commas. This rule may also be identified by a package or a full path, shown above."
                                        AutomationProperties.Name="Executable names"
                                        Header="Executable names"
                                        Text="{x:Bind ExecutableNames, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <CheckBox
                AutomationProperties.HelpText="Saves the preference in DesktopShift configuration. Startup registration is applied when that capability is available."
                Content="Start DesktopShift with Windows"
                IsChecked="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
