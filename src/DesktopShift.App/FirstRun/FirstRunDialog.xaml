<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="DesktopShift.App.FirstRun.FirstRunDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:rules="using:DesktopShift.App.Rules"
    xmlns:viewModels="using:DesktopShift.App.ViewModels"
    Width="920"
    MinWidth="0"
    MaxWidth="960"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    AutomationProperties.Name="Welcome to DesktopShift"
    CloseButtonText="Not now"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonText="Apply and continue">

    <ContentDialog.Resources>
        <!-- WinUI otherwise caps ContentDialog at 548 px. The setup form needs
             two real field columns and must remain centered as one surface. -->
        <x:Double x:Key="ContentDialogMinWidth">320</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer
        MaxHeight="590"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="52"
                    Height="52"
                    Background="{ThemeResource DesktopShift.AccentSoftBrush}"
                    CornerRadius="14">
                    <Image
                        Width="34"
                        Height="34"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        Source="ms-appx:///Assets/DesktopShiftLogo.svg"
                        Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock
                        FontFamily="Segoe UI Variable Display"
                        FontSize="26"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource DesktopShift.TextPrimaryBrush}"
                        Text="Welcome to DesktopShift" />
                    <TextBlock
                        MaxWidth="720"
                        HorizontalAlignment="Left"
                        Style="{StaticResource DesktopShift.PageSubtitleStyle}"
                        Text="Review the workspace DesktopShift will create. Nothing moves until you apply this setup."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <InfoBar
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="First run validation issues"
                IsClosable="False"
                IsIconVisible="True"
                IsOpen="{x:Bind ViewModel.HasValidationIssues, Mode=OneWay}"
                Message="{x:Bind ViewModel.ValidationSummary, Mode=OneWay}"
                Severity="Error"
                Title="Check the highlighted configuration" />

            <Border
                Padding="16"
                Background="{ThemeResource DesktopShift.SurfaceSecondaryBrush}"
                Style="{StaticResource DesktopShift.CardStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource DesktopShift.IconTileStyle}">
                        <FontIcon
                            Style="{StaticResource DesktopShift.IconTileGlyphStyle}"
                            Glyph="&#xE946;" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock
                            Style="{StaticResource DesktopShift.RowTitleStyle}"
                            Text="{x:Bind ViewModel.Compatibility.Mode, Mode=OneWay}" />
                        <TextBlock
                            MaxWidth="560"
                            HorizontalAlignment="Left"
                            Style="{StaticResource DesktopShift.CaptionStyle}"
                            Text="{x:Bind ViewModel.Compatibility.Explanation, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource DesktopShift.BadgeStyle}">
                        <TextBlock
                            Style="{StaticResource DesktopShift.BadgeTextStyle}"
                            Text="{x:Bind ViewModel.Compatibility.Build, Mode=OneWay}" />
                    </Border>
                </Grid>
            </Border>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource DesktopShift.SectionHeadingStyle}" Text="Starter mappings" />
                    <TextBlock
                        MaxWidth="680"
                        HorizontalAlignment="Left"
                        Style="{StaticResource DesktopShift.PageSubtitleStyle}"
                        Text="Rename a desktop, adjust executable names, or turn off a mapping you do not want."
                        TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource DesktopShift.BadgeStyle}">
                    <TextBlock Style="{StaticResource DesktopShift.BadgeTextStyle}" Text="Review before applying" />
                </Border>
            </Grid>

            <ListView
                AutomationProperties.Name="Starter mappings"
                IsItemClickEnabled="False"
                ItemContainerStyle="{StaticResource DesktopShift.CardListItemStyle}"
                ItemsSource="{x:Bind ViewModel.Mappings, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:FirstRunMappingViewModel">
                        <Border Padding="18,16" Style="{StaticResource DesktopShift.CardStyle}">
                            <Grid ColumnSpacing="18" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource DesktopShift.SectionTitleStyle}"
                                        Text="{x:Bind RuleName, Mode=OneWay}" />
                                    <TextBlock
                                        Style="{StaticResource DesktopShift.CaptionStyle}"
                                        Text="{x:Bind DestinationSummary, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Style="{StaticResource DesktopShift.CaptionStyle}"
                                        Text="{x:Bind IdentitySummary, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind rules:RuleIconSource.TextVisibility(IdentitySummary), Mode=OneWay}" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{x:Bind RuleName, Mode=OneWay}"
                                    IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                    OffContent="Off"
                                    OnContent="On" />
                                <Border
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Style="{StaticResource DesktopShift.SeparatorStyle}" />
                                <Grid
                                    Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.HelpText="{x:Bind RuleName, Mode=OneWay}"
                                        AutomationProperties.Name="Managed desktop"
                                        Header="Managed desktop"
                                        Text="{x:Bind DesktopName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Visibility="{x:Bind rules:RuleIconSource.WhenTrue(IsDesktopNameEditable), Mode=OneWay}" />
                                    <StackPanel
                                        Spacing="5"
                                        Visibility="{x:Bind rules:RuleIconSource.TextVisibility(DestinationNote), Mode=OneWay}">
                                        <TextBlock Style="{StaticResource DesktopShift.FieldLabelStyle}" Text="Managed desktop" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource DesktopShift.BodyStyle}"
                                            Text="{x:Bind DestinationNote, Mode=OneWay}" />
                                    </StackPanel>
                                    <TextBox
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.HelpText="Separate multiple executable names with commas. This rule may also be identified by a package or a full path, shown above."
                                        AutomationProperties.Name="Executable names"
                                        Header="Executable names"
                                        Text="{x:Bind ExecutableNames, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border Padding="16" Style="{StaticResource DesktopShift.CardStyle}">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource DesktopShift.RowTitleStyle}" Text="Start with Windows" />
                        <TextBlock
                            MaxWidth="620"
                            HorizontalAlignment="Left"
                            Style="{StaticResource DesktopShift.CaptionStyle}"
                            Text="Keep workspace placement ready after you sign in. You can change this later in System settings."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.HelpText="Saves the preference in DesktopShift configuration. Startup registration is applied when that capability is available."
                        AutomationProperties.Name="Start DesktopShift with Windows"
                        IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Padding="16" Style="{StaticResource DesktopShift.CardStyle}">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource DesktopShift.RowTitleStyle}" Text="Record local activity" />
                        <TextBlock
                            MaxWidth="620"
                            HorizontalAlignment="Left"
                            Style="{StaticResource DesktopShift.CaptionStyle}"
                            Text="Keep privacy-safe assignment decisions and rotating troubleshooting logs on this device. Nothing is uploaded."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.HelpText="Stores routine DesktopShift activity locally for troubleshooting. Crash reporting remains available when this is off."
                        AutomationProperties.Name="Record local activity"
                        IsOn="{x:Bind ViewModel.RecordLocalActivity, Mode=TwoWay}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
