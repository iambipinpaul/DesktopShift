<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="DesktopShift.App.FirstRun.FirstRunDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:DesktopShift.App.ViewModels"
    MinWidth="700"
    MaxWidth="820"
    AutomationProperties.Name="Welcome to DesktopShift"
    CloseButtonText="Not now"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonText="Apply and continue">

    <ScrollViewer MaxHeight="690" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20">
            <StackPanel Spacing="7">
                <StackPanel Orientation="Horizontal" Spacing="11">
                    <Border
                        Width="36"
                        Height="36"
                        Background="{ThemeResource DesktopShift.AccentSoftBrush}"
                        CornerRadius="10">
                        <FontIcon
                            FontSize="17"
                            Foreground="{ThemeResource DesktopShift.AccentStrongBrush}"
                            Glyph="&#xE8B7;" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Style="{StaticResource DesktopShift.PageTitleStyle}" Text="Welcome to DesktopShift" />
                        <TextBlock Style="{StaticResource DesktopShift.CaptionStyle}" Text="REVIEW BEFORE ANYTHING MOVES" />
                    </StackPanel>
                </StackPanel>
                <TextBlock
                    Style="{StaticResource DesktopShift.PageSubtitleStyle}"
                    Text="DesktopShift keeps application windows on purpose-built Windows desktops. Review these starter mappings; nothing is applied until you continue." />
            </StackPanel>

            <InfoBar
                IsClosable="False"
                IsIconVisible="True"
                IsOpen="{x:Bind ViewModel.HasValidationIssues, Mode=OneWay}"
                Message="{x:Bind ViewModel.ValidationSummary, Mode=OneWay}"
                Severity="Error"
                Title="Check the highlighted configuration" />

            <Border Style="{StaticResource DesktopShift.CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        FontSize="20"
                        Foreground="{ThemeResource DesktopShift.WarningBrush}"
                        Glyph="&#xE7BA;" />
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock
                            FontWeight="SemiBold"
                            Style="{StaticResource DesktopShift.BodyStyle}"
                            Text="{x:Bind ViewModel.Compatibility.Mode, Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource DesktopShift.CaptionStyle}"
                            Text="{x:Bind ViewModel.Compatibility.Explanation, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Top"
                        Style="{StaticResource DesktopShift.CaptionStyle}"
                        Text="{x:Bind ViewModel.Compatibility.Build, Mode=OneWay}" />
                </Grid>
            </Border>

            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource DesktopShift.SectionTitleStyle}" Text="Starter mappings" />
                <TextBlock Style="{StaticResource DesktopShift.PageSubtitleStyle}" Text="Rename a desktop, adjust executable names, or turn off any mapping you do not want." />
            </StackPanel>

            <ListView
                AutomationProperties.Name="Starter mappings"
                IsItemClickEnabled="False"
                ItemsSource="{x:Bind ViewModel.Mappings, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                        <Setter Property="CornerRadius" Value="12" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:FirstRunMappingViewModel">
                        <Border Style="{StaticResource DesktopShift.CardStyle}">
                            <Grid RowSpacing="12" ColumnSpacing="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Style="{StaticResource DesktopShift.SectionTitleStyle}"
                                        Text="{x:Bind RuleName, Mode=OneWay}" />
                                    <TextBlock
                                        Style="{StaticResource DesktopShift.CaptionStyle}"
                                        Text="{x:Bind SemanticKey, Mode=OneWay}" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{x:Bind RuleName, Mode=OneWay}"
                                    IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                    OffContent="Disabled"
                                    OnContent="Enabled" />
                                <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="3*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        AutomationProperties.Name="Managed desktop name"
                                        Header="Managed desktop"
                                        Text="{x:Bind DesktopName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox
                                        Grid.Column="1"
                                        AutomationProperties.HelpText="Separate multiple executable names with commas."
                                        AutomationProperties.Name="Executable names"
                                        Header="Executable names"
                                        Text="{x:Bind ExecutableNames, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <CheckBox
                AutomationProperties.HelpText="Saves the preference in DesktopShift configuration. Startup registration is applied when that capability is available."
                Content="Start DesktopShift with Windows"
                IsChecked="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
